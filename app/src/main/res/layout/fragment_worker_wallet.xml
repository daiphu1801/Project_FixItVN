<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#f0faff"
    android:orientation="vertical">

    <!-- ═══════════════════════════════════════════════
         TOPBAR (← back + tiêu đề)
         ═══════════════════════════════════════════════ -->
    <include layout="@layout/layout_worker_topbar" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="32dp">

            <!-- ═══════════════════════════════════════════════
                 CARD 1 — VÍ KHẢ DỤNG (có thể rút về ngân hàng)
                 Màu xanh chủ đạo, to nhất, nổi bật nhất
                 ═══════════════════════════════════════════════ -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="16dp"
                app:cardBackgroundColor="#42c2ff"
                app:cardCornerRadius="20dp"
                app:cardElevation="6dp"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="24dp">

                    <!-- Tiêu đề -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="💳  Ví khả dụng"
                            android:textColor="#d0f4ff"
                            android:textSize="14sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="#33ffffff"
                            android:paddingHorizontal="10dp"
                            android:paddingVertical="4dp"
                            android:text="Có thể rút"
                            android:textColor="#ffffff"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <!-- Số dư lớn -->
                    <TextView
                        android:id="@+id/tvAvailableBalance"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="1.250.000 đ"
                        android:textColor="#ffffff"
                        android:textSize="36sp"
                        android:textStyle="bold"
                        tools:ignore="HardcodedText" />

                    <!-- Nút hành động: chỉ Rút tiền -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnWithdraw"
                        style="@style/FixIt.Button.Action"
                        android:layout_width="match_parent"
                        android:layout_marginTop="20dp"
                        android:text="Rút tiền về ngân hàng"
                        android:textColor="#42c2ff"
                        app:backgroundTint="#ffffff" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ═══════════════════════════════════════════════
                 HÀNG 2 CARD NHỎ: Tạm giữ & Ghi nợ (cạnh nhau)
                 ═══════════════════════════════════════════════ -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <!-- ── CARD Ví Tạm giữ (tone vàng cảnh báo) ── -->
                <com.google.android.material.card.MaterialCardView
                    style="@style/FixIt.Card.Content"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:layout_marginBottom="0dp"
                    app:cardBackgroundColor="#fffbeb"
                    app:strokeColor="#fde68a"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="⏳  Tạm giữ"
                            android:textColor="#92400e"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvHeldBalance"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="320.000 đ"
                            android:textColor="#b45309"
                            android:textSize="22sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="Bảo hành 96 giờ"
                            android:textColor="#d97706"
                            android:textSize="11sp" />

                        <!-- Nút xem chi tiết -->
                        <TextView
                            android:id="@+id/btnHeldDetail"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:background="@drawable/chip_primary_light_bg"
                            android:clickable="true"
                            android:focusable="true"
                            android:paddingHorizontal="12dp"
                            android:paddingVertical="5dp"
                            android:text="Xem chi tiết →"
                            android:textColor="#b45309"
                            android:textSize="12sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- ── CARD Ví Ghi nợ (tone đỏ cảnh báo) ── -->
                <com.google.android.material.card.MaterialCardView
                    style="@style/FixIt.Card.Content"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:layout_marginBottom="0dp"
                    app:cardBackgroundColor="#fff5f5"
                    app:strokeColor="#fca5a5"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="⚠️  Ghi nợ"
                            android:textColor="#991b1b"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvDebtBalance"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="75.000 đ"
                            android:textColor="#dc2626"
                            android:textSize="22sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="Hoa hồng tích lũy (15%)"
                            android:textColor="#ef4444"
                            android:textSize="11sp" />

                        <!-- Nút nạp tiền -->
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnTopUp"
                            android:layout_width="match_parent"
                            android:layout_height="36dp"
                            android:layout_marginTop="10dp"
                            android:text="Nạp tiền"
                            android:textSize="12sp"
                            app:backgroundTint="#ef4444"
                            app:cornerRadius="10dp"
                            app:elevation="0dp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <!-- ═══════════════════════════════════════════════
                 LỊCH SỬ GIAO DỊCH + TAB PHÂN LOẠI
                 ═══════════════════════════════════════════════ -->
            <TextView
                style="@style/FixIt.Text.SectionHeader"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="8dp"
                android:text="Lịch sử giao dịch"
                android:textSize="18sp" />

            <!-- Tab phân loại giao dịch -->
            <com.google.android.material.tabs.TabLayout
                android:id="@+id/tabLayoutTx"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:background="@android:color/white"
                app:tabIndicatorColor="#42c2ff"
                app:tabSelectedTextColor="#42c2ff"
                app:tabTextColor="#888888"
                app:tabMode="fixed"
                app:tabGravity="fill">

                <com.google.android.material.tabs.TabItem
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Khả dụng" />

                <com.google.android.material.tabs.TabItem
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Tạm giữ" />

                <com.google.android.material.tabs.TabItem
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Ghi nợ" />
            </com.google.android.material.tabs.TabLayout>

            <!-- Danh sách giao dịch -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvWalletTransactions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="8dp"
                android:nestedScrollingEnabled="false"
                tools:listitem="@layout/item_wallet_transaction" />

            <include layout="@layout/layout_empty_state" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</LinearLayout>
