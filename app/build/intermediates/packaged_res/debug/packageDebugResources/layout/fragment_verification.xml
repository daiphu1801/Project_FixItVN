<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#f0faff">

    <!-- Header Toolbar -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/headerToolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:paddingHorizontal="16dp"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:padding="8dp"
            android:src="@drawable/ic_lucide_arrow_left"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="#42c2ff" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:text="FixIt VN"
            android:textColor="#42c2ff"
            android:textSize="18sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@id/btnBack"
            app:layout_constraintTop_toTopOf="parent" />

        <com.google.android.material.imageview.ShapeableImageView
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:src="@drawable/ic_lucide_user"
            android:padding="4dp"
            android:background="#e2e8f0"
            app:shapeAppearanceOverlay="@style/ShapeAppearance.MaterialComponents.SmallComponent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Main Scroll Content -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingBottom="100dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/headerToolbar">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="20dp">

            <TextView
                android:id="@+id/tvTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Xác minh danh tính"
                android:textColor="#0d1b2a"
                android:textSize="24sp"
                android:textStyle="bold" 
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"/>

            <TextView
                android:id="@+id/tvDesc"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Hoàn thành các bước dưới đây để trở thành thợ chính thức của hệ thống."
                android:textColor="#718096"
                android:textSize="14sp" 
                app:layout_constraintTop_toBottomOf="@id/tvTitle"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"/>

            <!-- Status Card: Pending -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardPending"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                app:cardBackgroundColor="#fff7ed"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                app:strokeColor="#ffedd5"
                app:strokeWidth="1dp"
                app:layout_constraintTop_toBottomOf="@id/tvDesc">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="16dp">

                    <ImageView
                        android:id="@+id/ivStatusIcon"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@android:drawable/ic_menu_recent_history"
                        app:tint="#f59e0b" 
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"/>

                    <TextView
                        android:id="@+id/tvStatusTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:text="Đang chờ phê duyệt"
                        android:textColor="#92400e"
                        android:textStyle="bold" 
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintStart_toEndOf="@id/ivStatusIcon"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintBottom_toTopOf="@id/tvStatusDesc"
                        app:layout_constraintVertical_chainStyle="packed"/>

                    <TextView
                        android:id="@+id/tvStatusDesc"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_marginTop="4dp"
                        android:text="Hồ sơ của bạn đang được xét duyệt. Quá trình này thường mất từ 1-2 ngày làm việc."
                        android:textColor="#b45309"
                        android:textSize="13sp" 
                        app:layout_constraintTop_toBottomOf="@id/tvStatusTitle"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toEndOf="@id/ivStatusIcon"
                        app:layout_constraintEnd_toEndOf="parent"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Step 1: ID Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardStep1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                app:cardBackgroundColor="#ffffff"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:layout_constraintTop_toBottomOf="@id/cardPending">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="16dp">

                    <TextView
                        android:id="@+id/tvStep1Badge"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:background="@drawable/circle_primary_light"
                        android:backgroundTint="#42c2ff"
                        android:gravity="center"
                        android:text="1"
                        android:textColor="#ffffff"
                        android:textSize="12sp"
                        android:textStyle="bold" 
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintStart_toStartOf="parent"/>

                    <TextView
                        android:id="@+id/tvStep1Title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:text="Chụp ảnh CCCD/CMND"
                        android:textColor="#0d1b2a"
                        android:textSize="16sp"
                        android:textStyle="bold" 
                        app:layout_constraintTop_toTopOf="@id/tvStep1Badge"
                        app:layout_constraintBottom_toBottomOf="@id/tvStep1Badge"
                        app:layout_constraintStart_toEndOf="@id/tvStep1Badge"/>

                    <TextView
                        android:id="@+id/tvStep1Desc"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="Vui lòng chụp rõ nét mặt trước và mặt sau. Không lóa sáng, không bị che khuất."
                        android:textColor="#718096"
                        android:textSize="13sp" 
                        app:layout_constraintTop_toBottomOf="@id/tvStep1Badge"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"/>

                    <!-- Front Side -->
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/layoutFrontSide"
                        android:layout_width="0dp"
                        android:layout_height="100dp"
                        android:layout_marginEnd="8dp"
                        android:layout_marginTop="16dp"
                        android:background="@drawable/bg_dashed_border"
                        app:layout_constraintTop_toBottomOf="@id/tvStep1Desc"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toStartOf="@id/layoutBackSide"
                        app:layout_constraintHorizontal_chainStyle="spread">

                        <ImageView
                            android:id="@+id/ivFrontCam"
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:src="@android:drawable/ic_menu_camera"
                            app:tint="#94a3b8" 
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintBottom_toTopOf="@id/tvFrontLabel"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintVertical_chainStyle="packed"/>

                        <TextView
                            android:id="@+id/tvFrontLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="Mặt trước"
                            android:textColor="#64748b"
                            android:textSize="12sp" 
                            app:layout_constraintTop_toBottomOf="@id/ivFrontCam"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"/>
                    </androidx.constraintlayout.widget.ConstraintLayout>

                    <!-- Back Side -->
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/layoutBackSide"
                        android:layout_width="0dp"
                        android:layout_height="100dp"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_dashed_border"
                        app:layout_constraintTop_toTopOf="@id/layoutFrontSide"
                        app:layout_constraintStart_toEndOf="@id/layoutFrontSide"
                        app:layout_constraintEnd_toEndOf="parent">

                        <ImageView
                            android:id="@+id/ivBackCam"
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:src="@android:drawable/ic_menu_camera"
                            app:tint="#94a3b8" 
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintBottom_toTopOf="@id/tvBackLabel"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintVertical_chainStyle="packed"/>

                        <TextView
                            android:id="@+id/tvBackLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="Mặt sau"
                            android:textColor="#64748b"
                            android:textSize="12sp" 
                            app:layout_constraintTop_toBottomOf="@id/ivBackCam"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"/>
                    </androidx.constraintlayout.widget.ConstraintLayout>
                </androidx.constraintlayout.widget.ConstraintLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Step 2: Certificate -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardStep2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                app:cardBackgroundColor="#ffffff"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:layout_constraintTop_toBottomOf="@id/cardStep1">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="16dp">

                    <TextView
                        android:id="@+id/tvStep2Badge"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:background="@drawable/circle_primary_light"
                        android:backgroundTint="#e2e8f0"
                        android:gravity="center"
                        android:text="2"
                        android:textColor="#64748b"
                        android:textSize="12sp"
                        android:textStyle="bold" 
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintStart_toStartOf="parent"/>

                    <TextView
                        android:id="@+id/tvStep2Title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:text="Chứng chỉ nghề nghiệp"
                        android:textColor="#0d1b2a"
                        android:textSize="16sp"
                        android:textStyle="bold" 
                        app:layout_constraintTop_toTopOf="@id/tvStep2Badge"
                        app:layout_constraintBottom_toBottomOf="@id/tvStep2Badge"
                        app:layout_constraintStart_toEndOf="@id/tvStep2Badge"/>

                    <TextView
                        android:id="@+id/tvStep2Desc"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="Tải lên bằng cấp, chứng chỉ hoặc giấy phép hành nghề liên quan đến chuyên môn của bạn."
                        android:textColor="#718096"
                        android:textSize="13sp" 
                        app:layout_constraintTop_toBottomOf="@id/tvStep2Badge"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"/>

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/layoutUpload"
                        android:layout_width="match_parent"
                        android:layout_height="140dp"
                        android:layout_marginTop="16dp"
                        android:background="@drawable/bg_dashed_border"
                        app:layout_constraintTop_toBottomOf="@id/tvStep2Desc">

                        <ImageView
                            android:id="@+id/ivUpload"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:src="@android:drawable/stat_sys_upload"
                            app:tint="#94a3b8" 
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintBottom_toTopOf="@id/tvUploadTitle"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintVertical_chainStyle="packed"/>

                        <TextView
                            android:id="@+id/tvUploadTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="Nhấn để tải tài liệu lên"
                            android:textColor="#42c2ff"
                            android:textStyle="bold" 
                            app:layout_constraintTop_toBottomOf="@id/ivUpload"
                            app:layout_constraintBottom_toTopOf="@id/tvUploadDesc"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"/>

                        <TextView
                            android:id="@+id/tvUploadDesc"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="Hỗ trợ JPG, PNG, PDF (Tối đa 5MB)"
                            android:textColor="#94a3b8"
                            android:textSize="11sp" 
                            app:layout_constraintTop_toBottomOf="@id/tvUploadTitle"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"/>
                    </androidx.constraintlayout.widget.ConstraintLayout>
                </androidx.constraintlayout.widget.ConstraintLayout>
            </com.google.android.material.card.MaterialCardView>

        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Bottom Button Area -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#ffffff"
        android:padding="20dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSubmit"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:backgroundTint="#81b2c4"
            android:text="Gửi hồ sơ xét duyệt"
            android:textAllCaps="false"
            android:textSize="18sp"
            android:textStyle="bold"
            app:cornerRadius="12dp" />
    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
