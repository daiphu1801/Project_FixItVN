<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:ns1="http://schemas.android.com/tools">
    <color name="white">#FFFFFFFF</color>
    <string name="already_have_account">Đã có tài khoản? </string>
    <string name="app_name">FixIt VN</string>
    <string name="confirm_password">Xác nhận mật khẩu</string>
    <string name="create_account_subtitle">Tạo tài khoản để trải nghiệm dịch vụ tuyệt vời</string>
    <string name="forgot_password">Quên mật khẩu?</string>
    <string name="full_name">Họ và tên</string>
    <string name="login">Đăng nhập</string>
    <string name="login_now">Đăng nhập ngay</string>
    <string name="no_account_yet">Chưa có tài khoản? </string>
    <string name="password">Mật khẩu</string>
    <string name="phone_number">Số điện thoại</string>
    <string name="register">Đăng ký</string>
    <string name="register_now">Đăng ký ngay</string>
    <string name="welcome_back">Chào mừng bạn quay trở lại với FixIt VN</string>
    <style name="CustomBottomSheetStyle" parent="Widget.Design.BottomSheet.Modal">
        <item name="android:background">@android:color/transparent</item>
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.FixIt.BottomSheet</item>
    </style>
    <style name="FixIt"/>
    <style name="FixIt.Button"/>
    <style name="FixIt.Button.Action" parent="Widget.MaterialComponents.Button">
        <item name="android:layout_height">56dp</item>
        <item name="cornerRadius">12dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>
    <style name="FixIt.Button.Action.Outlined" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:layout_height">56dp</item>
        <item name="cornerRadius">12dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>
    <style name="FixIt.Button.Action.Primary" parent="FixIt.Button.Action">
        <item name="backgroundTint">?attr/colorPrimary</item>
        <item name="android:textColor">@android:color/white</item>
    </style>
    <style name="FixIt.Card"/>
    <style name="FixIt.Card.Content" parent="Widget.MaterialComponents.CardView">
        <item name="cardBackgroundColor">@android:color/white</item>
        <item name="cardCornerRadius">16dp</item>
        <item name="cardElevation">2dp</item>
        <item name="strokeWidth">0dp</item>
        <item name="android:layout_marginBottom">16dp</item>
    </style>
    <style name="FixIt.Order"/>
    <style name="FixIt.Order.Badge">
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:paddingHorizontal" ns1:targetApi="26">12dp</item>
        <item name="android:paddingVertical" ns1:targetApi="26">6dp</item>
    </style>
    <style name="FixIt.Text"/>
    <style name="FixIt.Text.InfoRow">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">#0d1b2a</item>
        <item name="android:layout_marginStart">12dp</item>
    </style>
    <style name="FixIt.Text.SectionHeader">
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">#0d1b2a</item>
        <item name="android:textStyle">bold</item>
        <item name="android:layout_marginBottom">12dp</item>
        <item name="android:layout_marginTop">8dp</item>
    </style>
    <style name="ShapeAppearance.FixIt.BottomSheet" parent="">
        <item name="cornerSizeTopLeft">32dp</item>
        <item name="cornerSizeTopRight">32dp</item>
        <item name="cornerSizeBottomLeft">0dp</item>
        <item name="cornerSizeBottomRight">0dp</item>
    </style>
    <style name="Theme.FixIt.BottomSheetDialog" parent="Theme.Design.Light.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/CustomBottomSheetStyle</item>
    </style>
    <style name="Theme.FixItVN" parent="Theme.MaterialComponents.DayNight.NoActionBar">

        
        <item name="colorPrimary">#42c2ff</item>
        <item name="colorPrimaryDark">#00658b</item>
        <item name="colorPrimaryVariant">#00658b</item>
        <item name="colorOnPrimary">#ffffff</item>

        
        <item name="colorSecondary">#42c2ff</item>
        <item name="colorSecondaryVariant">#1a9fe0</item>
        <item name="colorOnSecondary">#ffffff</item>

        
        <item name="android:colorBackground">#f0faff</item>
        <item name="android:windowBackground">#f0faff</item>
        <item name="colorSurface">#ffffff</item>
        <item name="colorOnSurface">#0d1b2a</item>

        
        <item name="android:statusBarColor">#ffffff</item>
        <item name="android:windowLightStatusBar">true</item>

        
        <item name="android:navigationBarColor">#ffffff</item>

    </style>
</resources>