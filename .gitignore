# .gitignore — FixIt VN monorepo (Android & Java Backend)

# ===================== Maven (Backend) =====================
backend/target/
backend/*.jar
backend/*.war
backend/*.zip
backend/*.tar.gz
backend/*.class
backend/bin/
backend/.factorypath

# ===================== Gradle / Android =====================
android/.gradle/
android/build/
android/app/build/
android/local.properties
android/captures/
android/.externalNativeBuild/
android/.cxx/
# Quan trọng: Ignore gradle.properties vì nó chứa cấu hình Java Home cá nhân
android/gradle.properties

# ===================== IDE (IntelliJ, VS Code, Eclipse) =====================
.idea/
*.iml
*.iws
*.ipr
.vscode/
.settings/
.project
.classpath
*.swp
*.swo
*~

# ===================== Environment & Secrets =====================
*.env
.env.*
*.jks
*.keystore
# Lưu ý: Các file dưới đây nên được chia sẻ qua kênh bảo mật khác thay vì Git
google-services.json
firebase.json

# ===================== Database Dumps =====================
*.sql

# ===================== Spring Boot Config (Nhạy cảm) =====================
# application-dev.yml và application-prod.yml chứa credentials thật — KHÔNG commit
backend/src/main/resources/application-dev.yml
backend/src/main/resources/application-prod.yml

# ===================== OS (System) =====================
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini

# ===================== Logs, Caches & Docs =====================
*.log
logs/
.gradle/
docs/
