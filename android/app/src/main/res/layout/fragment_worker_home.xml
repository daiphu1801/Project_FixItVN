<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#f0faff">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Home Header (Merged from layout_worker_home_header) -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="16dp">

            <ImageView
                android:id="@+id/ivWorkerAvatar"
                android:layout_width="45dp"
                android:layout_height="47dp"
                android:layout_marginEnd="12dp"
                android:background="@drawable/circle_background"
                android:src="@drawable/ic_lucide_user"
                app:tint="#42c2ff" 
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"/>

            <TextView
                android:id="@+id/tvGreeting"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:text="Xin chào,"
                android:textColor="#94a3b8"
                android:textSize="12sp" 
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toEndOf="@id/ivWorkerAvatar"
                app:layout_constraintEnd_toStartOf="@id/flBell"
                app:layout_constraintBottom_toTopOf="@id/tvWorkerName"
                app:layout_constraintVertical_chainStyle="packed"/>

            <TextView
                android:id="@+id/tvWorkerName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:text="Nguyễn Văn A"
                android:textColor="#0d1b2a"
                android:textSize="18sp"
                android:textStyle="bold" 
                app:layout_constraintTop_toBottomOf="@id/tvGreeting"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toEndOf="@id/ivWorkerAvatar"
                app:layout_constraintEnd_toStartOf="@id/flBell"/>

            <FrameLayout
                android:id="@+id/flBell"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent">
                
                <ImageView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:src="@drawable/ic_lucide_bell"
                    app:tint="#42c2ff" />
                    
                <View
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:layout_gravity="top|end"
                    android:background="#ef4444"
                    android:layout_marginTop="2dp"
                    android:layout_marginEnd="2dp" />
            </FrameLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- Trạng thái nhận việc (read-only) — click → sang tab Tìm việc -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardToggle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:clickable="true"
            android:focusable="true"
            app:cardBackgroundColor="@android:color/white"
            app:cardCornerRadius="20dp"
            app:cardElevation="4dp"
            app:strokeColor="#e2e8f0"
            app:strokeWidth="2dp">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="16dp">

                <!-- Chấm trạng thái -->
                <View
                    android:id="@+id/viewStatusDot"
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:layout_marginEnd="12dp"
                    android:background="#94a3b8" 
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"/>

                <TextView
                    android:id="@+id/tvStatusDesc"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:text="OFFLINE"
                    android:textColor="#94a3b8"
                    android:textSize="14sp"
                    android:textStyle="bold" 
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toTopOf="@id/tvStatusHelp"
                    app:layout_constraintStart_toEndOf="@id/viewStatusDot"
                    app:layout_constraintEnd_toStartOf="@id/ivChevron"
                    app:layout_constraintVertical_chainStyle="packed"/>

                <TextView
                    android:id="@+id/tvStatusHelp"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_marginTop="2dp"
                    android:text="Nhấn để thay đổi trạng thái →"
                    android:textColor="#42c2ff"
                    android:textSize="12sp" 
                    app:layout_constraintTop_toBottomOf="@id/tvStatusDesc"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toEndOf="@id/viewStatusDot"
                    app:layout_constraintEnd_toStartOf="@id/ivChevron"/>

                <ImageView
                    android:id="@+id/ivChevron"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_lucide_chevron_right"
                    app:tint="#cbd5e1" 
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Reusable Shared Components -->
        <include android:id="@+id/layoutActiveOrder" layout="@layout/layout_card_active_order" />
        
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp">
            
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Thống kê thu nhập"
                android:textColor="#0d1b2a"
                android:textSize="18sp"
                android:textStyle="bold" 
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"/>
                
            <TextView
                android:id="@+id/tvViewStatsDetail"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Xem chi tiết"
                android:textColor="#42c2ff"
                android:textSize="14sp"
                android:textStyle="bold" 
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>

        <include android:id="@+id/layoutStats" layout="@layout/layout_stats_overview" />
        <include android:id="@+id/layoutChart" layout="@layout/layout_income_chart" />

        <!-- UC-W08: Lịch hẹn hôm nay -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp">
            
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Lịch hẹn hôm nay"
                android:textColor="#0d1b2a"
                android:textSize="18sp"
                android:textStyle="bold" 
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"/>
                
            <TextView
                android:id="@+id/tvViewAllAppointments"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Xem tất cả"
                android:textColor="#42c2ff"
                android:textSize="14sp"
                android:textStyle="bold" 
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvAppointments"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:nestedScrollingEnabled="false"
            tools:listitem="@layout/item_appointment" />

        <!-- Hiển thị khi không có lịch hẹn -->
        <TextView
            android:id="@+id/tvEmptyAppointments"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:gravity="center"
            android:text="Bạn chưa có lịch hẹn nào hôm nay."
            android:textColor="#888888"
            android:textSize="14sp"
            android:visibility="gone" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
