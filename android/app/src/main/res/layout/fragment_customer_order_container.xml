<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#f0faff">

    <!-- 1. GIAO DIỆN KHI KHÔNG CÓ ĐƠN HÀNG -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layoutEmptyOrder"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        tools:visibility="visible">

        <ImageView
            android:id="@+id/ivEmpty"
            android:layout_width="200dp"
            android:layout_height="200dp"
            android:src="@drawable/ic_lucide_clipboard_list"
            android:alpha="0.2"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_bias="0.4"
            app:tint="#42c2ff" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Hiện tại bạn chưa có đơn hàng nào"
            android:textColor="#6c757d"
            android:textSize="16sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/ivEmpty" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnOrderNow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="60dp"
            android:text="Đặt thợ ngay"
            app:cornerRadius="24dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/ivEmpty" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- 2. NƠI CHỨA CÁC GIAO DIỆN CHI TIẾT (RADAR HOẶC CHI TIẾT ĐƠN) -->
    <!-- Chúng ta dùng FrameLayout để lồng các Fragment con vào đây -->
    <FrameLayout
        android:id="@+id/orderContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="visible" />

</androidx.constraintlayout.widget.ConstraintLayout>
