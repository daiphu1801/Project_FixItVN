<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#f5fbff"
    android:padding="24dp">

    <!-- Trang trí nền (Subtle Decorative Circle) -->
    <View
        android:layout_width="220dp"
        android:layout_height="220dp"
        android:background="@drawable/bg_circle_light_blue"
        android:alpha="0.25"
        android:layout_marginTop="-110dp"
        android:layout_marginEnd="-110dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Nút quay lại thiết kế tròn thanh lịch đồng bộ -->
    <FrameLayout
        android:id="@+id/btnBackFrame"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="@drawable/bg_circle_white"
        android:elevation="2dp"
        android:clickable="true"
        android:focusable="true"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent">
        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_lucide_arrow_left"
            app:tint="#0f172a" />
    </FrameLayout>

    <TextView
        android:id="@+id/tvToolbarTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:text="Quên mật khẩu"
        android:textColor="#0f172a"
        android:textSize="20sp"
        android:textStyle="bold"
        app:layout_constraintTop_toTopOf="@id/btnBackFrame"
        app:layout_constraintBottom_toBottomOf="@id/btnBackFrame"
        app:layout_constraintStart_toEndOf="@id/btnBackFrame" />

    <!-- Main Content Scroll Container -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="20dp"
        android:scrollbars="none"
        app:layout_constraintBottom_toTopOf="@id/layoutBottom"
        app:layout_constraintTop_toBottomOf="@id/btnBackFrame">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="24dp">

            <!-- BƯỚC 1: NHẬP EMAIL -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/layoutStepEmail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="visible"
                app:layout_constraintTop_toTopOf="parent">

                <!-- Lock Icon Circle (Đã đổi từ icon hệ thống xấu xí sang Lucide siêu đẹp) -->
                <FrameLayout
                    android:id="@+id/iconContainer"
                    android:layout_width="88dp"
                    android:layout_height="88dp"
                    android:layout_marginTop="32dp"
                    android:background="@drawable/bg_circle_light_blue"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent">
                    <ImageView
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_lucide_lock"
                        app:tint="#42c2ff" />
                </FrameLayout>

                <TextView
                    android:id="@+id/tvFindPassword"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="40dp"
                    android:text="Tìm lại mật khẩu"
                    android:textColor="#0f172a"
                    android:textSize="26sp"
                    android:textStyle="bold" 
                    app:layout_constraintTop_toBottomOf="@id/iconContainer"
                    app:layout_constraintStart_toStartOf="parent"/>

                <TextView
                    android:id="@+id/tvDescription"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:lineSpacingExtra="4dp"
                    android:text="Đừng lo lắng! Hãy nhập email của bạn dưới đây, chúng tôi sẽ gửi mã OTP gồm 6 chữ số để xác thực tài khoản."
                    android:textColor="#64748b"
                    android:textSize="15sp" 
                    app:layout_constraintTop_toBottomOf="@id/tvFindPassword"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"/>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilEmail"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="32dp"
                    app:boxCornerRadiusBottomEnd="16dp"
                    app:boxCornerRadiusBottomStart="16dp"
                    app:boxCornerRadiusTopEnd="16dp"
                    app:boxCornerRadiusTopStart="16dp"
                    app:boxStrokeColor="#42c2ff"
                    app:hintTextColor="#42c2ff"
                    app:startIconDrawable="@drawable/ic_lucide_message"
                    app:startIconTint="#64748b"
                    app:layout_constraintTop_toBottomOf="@id/tvDescription"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etEmail"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Nhập email đã đăng ký của bạn"
                        android:inputType="textEmailAddress"
                        android:paddingVertical="16dp" />
                </com.google.android.material.textfield.TextInputLayout>

            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- BƯỚC 2: NHẬP MÃ OTP (Mặc định ẩn đi) -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/layoutStepOTP"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone"
                app:layout_constraintTop_toTopOf="parent">

                <!-- Alert Info Icon (Đã đổi sang Lucide hiện đại kết hợp vòng tròn màu cam kỹ thuật) -->
                <FrameLayout
                    android:id="@+id/iconContainerOTP"
                    android:layout_width="88dp"
                    android:layout_height="88dp"
                    android:layout_marginTop="32dp"
                    android:background="@drawable/bg_badge_orange_light"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent">
                    <ImageView
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_lucide_alert_circle"
                        app:tint="#f97316" />
                </FrameLayout>

                <TextView
                    android:id="@+id/tvVerifyOTPTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="40dp"
                    android:text="Xác thực OTP"
                    android:textColor="#0f172a"
                    android:textSize="26sp"
                    android:textStyle="bold" 
                    app:layout_constraintTop_toBottomOf="@id/iconContainerOTP"
                    app:layout_constraintStart_toStartOf="parent"/>

                <TextView
                    android:id="@+id/tvVerifyOTPDesc"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:lineSpacingExtra="4dp"
                    android:text="Chúng tôi đã gửi mã xác thực gồm 6 chữ số đến email của bạn. Vui lòng kiểm tra hòm thư chính và cả thư rác."
                    android:textColor="#64748b"
                    android:textSize="15sp" 
                    app:layout_constraintTop_toBottomOf="@id/tvVerifyOTPTitle"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"/>

                <!-- Ô nhập mã OTP siêu đẹp và rộng rãi -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilOTP"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="32dp"
                    app:boxCornerRadiusBottomEnd="16dp"
                    app:boxCornerRadiusBottomStart="16dp"
                    app:boxCornerRadiusTopEnd="16dp"
                    app:boxCornerRadiusTopStart="16dp"
                    app:boxStrokeColor="#42c2ff"
                    app:layout_constraintTop_toBottomOf="@id/tvVerifyOTPDesc"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etOTP"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:hint="0 0 0 0 0 0"
                        android:inputType="number"
                        android:letterSpacing="0.4"
                        android:maxLength="6"
                        android:textColor="#0f172a"
                        android:paddingVertical="16dp"
                        android:textSize="22sp"
                        android:textStyle="bold" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Nút đếm ngược gửi lại mã -->
                <TextView
                    android:id="@+id/tvResendCode"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="Gửi lại mã (59s)"
                    android:textColor="#42c2ff"
                    android:textSize="15sp"
                    android:textStyle="bold" 
                    app:layout_constraintTop_toBottomOf="@id/tilOTP"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"/>
            </androidx.constraintlayout.widget.ConstraintLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Bottom Action Area -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layoutBottom"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingVertical="16dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSendCode"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:backgroundTint="#42c2ff"
            android:text="Gửi mã xác thực"
            android:textAllCaps="false"
            android:textSize="16sp"
            android:textStyle="bold"
            app:cornerRadius="16dp" 
            android:elevation="4dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <TextView
            android:id="@+id/tvSupportPrompt"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Gặp khó khăn? "
            android:textColor="#64748b" 
            app:layout_constraintTop_toBottomOf="@id/btnSendCode"
            app:layout_constraintEnd_toStartOf="@id/tvSupport"
            app:layout_constraintHorizontal_chainStyle="packed"
            app:layout_constraintStart_toStartOf="parent"/>

        <TextView
            android:id="@+id/tvSupport"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Liên hệ hỗ trợ"
            android:textColor="#42c2ff"
            android:textStyle="bold" 
            app:layout_constraintTop_toTopOf="@id/tvSupportPrompt"
            app:layout_constraintBottom_toBottomOf="@id/tvSupportPrompt"
            app:layout_constraintStart_toEndOf="@id/tvSupportPrompt"
            app:layout_constraintEnd_toEndOf="parent"/>

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
