<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#f9fafb"
        android:orientation="vertical">

    <!-- ═══════════════════════════════════════════════
         TOPBAR
         ═══════════════════════════════════════════════ -->
    <include layout="@layout/layout_worker_topbar" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="40dp">

            <!-- ═══════════════════════════════════════════════
                 BANNER CẢNH BÁO (Tone đỏ)
                 ═══════════════════════════════════════════════ -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#fef2f2"
                android:paddingHorizontal="16dp"
                android:paddingVertical="12dp">

                <ImageView
                    android:id="@+id/ivAlert"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_lucide_alert_circle"
                    app:tint="#ef4444" 
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"/>

                <TextView
                    android:id="@+id/tvAlertText"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:text="Có khiếu nại mới cần phản hồi"
                    android:textColor="#991b1b"
                    android:textSize="14sp"
                    android:textStyle="bold" 
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toEndOf="@id/ivAlert"
                    app:layout_constraintEnd_toStartOf="@id/tvCountdown"/>

                <TextView
                    android:id="@+id/tvCountdown"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="18:42:00"
                    android:textColor="#ef4444"
                    android:textSize="14sp"
                    android:textStyle="bold" 
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"/>
            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- ═══════════════════════════════════════════════
                 THÔNG TIN ĐƠN HÀNG & KHIẾU NẠI
                 ═══════════════════════════════════════════════ -->
            <com.google.android.material.card.MaterialCardView
                style="@style/FixIt.Card.Content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="16dp"
                app:cardCornerRadius="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:id="@+id/tvOrderTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="📦 Đơn #ORD004 – Thông tắc bồn rửa bát"
                        android:textColor="#333333"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvCompleteDate"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Ngày hoàn thành: 08/06/2024"
                        android:textColor="#888888"
                        android:textSize="13sp" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginVertical="12dp"
                        android:background="#f3f4f6" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Nội dung khiếu nại của khách:"
                        android:textColor="#4b5563"
                        android:textSize="13sp" />

                    <!-- Bubble Chat Khiếu nại -->
                    <TextView
                        android:id="@+id/tvComplaintReason"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/bg_complaint_bubble"
                        android:padding="12dp"
                        android:text="Máy lạnh vẫn còn kêu rè sau khi sửa, chạy 2 ngày lại hỏng"
                        android:textColor="#b91c1c"
                        android:textSize="14sp" />

                    <!-- Ảnh khách gửi -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:orientation="horizontal">

                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="80dp"
                            android:layout_height="80dp"
                            android:layout_marginEnd="8dp"
                            app:cardCornerRadius="8dp"
                            app:strokeColor="#e5e7eb"
                            app:strokeWidth="1dp">
                            <ImageView
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:scaleType="centerCrop"
                                android:src="@drawable/ic_lucide_image"
                                app:tint="#d1d5db" />
                        </com.google.android.material.card.MaterialCardView>

                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="80dp"
                            android:layout_height="80dp"
                            app:cardCornerRadius="8dp"
                            app:strokeColor="#e5e7eb"
                            app:strokeWidth="1dp">
                            <ImageView
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:scaleType="centerCrop"
                                android:src="@drawable/ic_lucide_image"
                                app:tint="#d1d5db" />
                        </com.google.android.material.card.MaterialCardView>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ═══════════════════════════════════════════════
                 TIỀN ĐANG BỊ GIỮ
                 ═══════════════════════════════════════════════ -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                app:cardBackgroundColor="#fff7ed"
                app:cardCornerRadius="12dp"
                app:strokeColor="#fde68a"
                app:strokeWidth="1dp">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="16dp">

                    <TextView
                        android:id="@+id/tvFrozenLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Tiền đang bị đóng băng:"
                        android:textColor="#92400e"
                        android:textSize="14sp" 
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintStart_toStartOf="parent"/>

                    <TextView
                        android:id="@+id/tvFrozenAmount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="350,000đ"
                        android:textColor="#d97706"
                        android:textSize="24sp"
                        android:textStyle="bold" 
                        app:layout_constraintTop_toBottomOf="@id/tvFrozenLabel"
                        app:layout_constraintStart_toStartOf="parent"/>

                    <TextView
                        android:id="@+id/tvFrozenDesc"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Chờ phán quyết của Admin FixIt"
                        android:textColor="#b45309"
                        android:textSize="12sp" 
                        app:layout_constraintTop_toBottomOf="@id/tvFrozenAmount"
                        app:layout_constraintStart_toStartOf="parent"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ═══════════════════════════════════════════════
                 PHẦN GIẢI TRÌNH CỦA THỢ
                 ═══════════════════════════════════════════════ -->
            <TextView
                style="@style/FixIt.Text.SectionHeader"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="24dp"
                android:text="Giải trình của bạn"
                android:textSize="16sp" />

            <EditText
                android:id="@+id/etResponse"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_input_field"
                android:gravity="top"
                android:hint="Mô tả lý do bạn không có lỗi trong vụ việc này..."
                android:inputType="textMultiLine"
                android:minLines="5"
                android:padding="12dp"
                android:textSize="14sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="4dp"
                android:text="0/500"
                android:textColor="#9ca3af"
                android:textSize="12sp" />

            <!-- Nút thêm ảnh -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAddEvidence"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="12dp"
                android:text="Thêm ảnh bằng chứng mới"
                android:textColor="#4b5563"
                app:icon="@drawable/ic_lucide_camera"
                app:iconTint="#4b5563"
                app:strokeColor="#d1d5db" />

            <!-- Danh sách ảnh bằng chứng đã chọn -->
            <HorizontalScrollView
                android:id="@+id/hsvEvidenceImages"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="8dp"
                android:scrollbars="none"
                android:visibility="gone">

                <LinearLayout
                    android:id="@+id/llEvidenceImages"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal" />
            </HorizontalScrollView>

            <!-- ═══════════════════════════════════════════════
                 NÚT HÀNH ĐỘNG
                 ═══════════════════════════════════════════════ -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:paddingHorizontal="16dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnRefund"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:text="Đề xuất hoàn tiền một phần"
                    android:textColor="#d97706"
                    app:strokeColor="#fde68a" 
                    app:layout_constraintTop_toTopOf="parent"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSubmitResponse"
                    style="@style/FixIt.Button.Action.Primary"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginTop="12dp"
                    android:text="Gửi phản hồi bảo vệ quyền lợi"
                    android:textAllCaps="false"
                    android:textStyle="bold" 
                    app:layout_constraintTop_toBottomOf="@id/btnRefund"/>
            </androidx.constraintlayout.widget.ConstraintLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
    </LinearLayout>

    <include
        android:id="@+id/layoutLoading"
        layout="@layout/layout_loading"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

</FrameLayout>
