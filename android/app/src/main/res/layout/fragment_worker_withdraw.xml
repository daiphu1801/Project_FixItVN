<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#f8fafc">

    <!-- TopBar -->
    <RelativeLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@android:color/white"
        android:paddingHorizontal="16dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_centerVertical="true"
            android:src="@drawable/ic_arrow_back"
            android:contentDescription="Quay lại"
            app:tint="#0f172a"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackgroundBorderless"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:text="Rút tiền về ngân hàng"
            android:textColor="#0f172a"
            android:textSize="18sp"
            android:textStyle="bold" />
    </RelativeLayout>

    <View
        android:id="@+id/topBarDivider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#e2e8f0"
        app:layout_constraintTop_toBottomOf="@id/topBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toBottomOf="@id/topBarDivider"
        app:layout_constraintBottom_toTopOf="@id/bottomDivider"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="20dp">

            <!-- Mock Simulation Warning Banner -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardMockWarning"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="#fffbeb"
                app:strokeWidth="1dp"
                app:strokeColor="#fef3c7"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="16dp">

                    <ImageView
                        android:id="@+id/ivMockIcon"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_lucide_alert_triangle"
                        app:tint="#d97706"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintStart_toStartOf="parent" />

                    <TextView
                        android:id="@+id/tvMockTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:text="Chế độ giả lập (Dev Mode)"
                        android:textColor="#b45309"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        app:layout_constraintTop_toTopOf="@id/ivMockIcon"
                        app:layout_constraintBottom_toBottomOf="@id/ivMockIcon"
                        app:layout_constraintStart_toEndOf="@id/ivMockIcon"
                        app:layout_constraintEnd_toEndOf="parent" />

                    <TextView
                        android:id="@+id/tvMockDescription"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Lưu ý: Môi trường thử nghiệm đang sử dụng cơ chế duyệt rút tiền tự động. Tiền sẽ được cộng/trừ giả lập thành công trong vòng 5 giây."
                        android:textColor="#d97706"
                        android:textSize="12sp"
                        app:layout_constraintTop_toBottomOf="@id/ivMockIcon"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent" />
                </androidx.constraintlayout.widget.ConstraintLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Available Balance Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardBalance"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="#eff6ff"
                app:strokeWidth="1dp"
                app:strokeColor="#dbeafe"
                app:layout_constraintTop_toBottomOf="@id/cardMockWarning"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="20dp">

                    <ImageView
                        android:id="@+id/ivBalanceIcon"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:src="@drawable/ic_lucide_wallet"
                        app:tint="#2563eb"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintStart_toStartOf="parent" />

                    <TextView
                        android:id="@+id/tvBalanceLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:text="Số dư ví khả dụng"
                        android:textColor="#1e3a8a"
                        android:textSize="14sp"
                        app:layout_constraintTop_toTopOf="@id/ivBalanceIcon"
                        app:layout_constraintBottom_toTopOf="@id/tvAvailableBalance"
                        app:layout_constraintStart_toEndOf="@id/ivBalanceIcon" />

                    <TextView
                        android:id="@+id/tvAvailableBalance"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="0 đ"
                        android:textColor="#2563eb"
                        android:textSize="28sp"
                        android:textStyle="bold"
                        app:layout_constraintTop_toBottomOf="@id/tvBalanceLabel"
                        app:layout_constraintStart_toStartOf="@id/tvBalanceLabel" />
                </androidx.constraintlayout.widget.ConstraintLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Bank Account Label -->
            <TextView
                android:id="@+id/tvBankLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="Tài khoản nhận tiền"
                android:textColor="#475569"
                android:textSize="14sp"
                android:textStyle="bold"
                app:layout_constraintTop_toBottomOf="@id/cardBalance"
                app:layout_constraintStart_toStartOf="parent" />

            <!-- Bank Account Target Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardBankAccount"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@android:color/white"
                app:strokeWidth="1dp"
                app:strokeColor="#e2e8f0"
                app:layout_constraintTop_toBottomOf="@id/tvBankLabel"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/layoutBankDetails"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="20dp"
                        android:visibility="visible">

                        <ImageView
                            android:id="@+id/ivBankCardChip"
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:src="@drawable/ic_lucide_wallet"
                            app:tint="#64748b"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintStart_toStartOf="parent" />

                        <TextView
                            android:id="@+id/tvBankName"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:text="MB Bank"
                            android:textColor="#0f172a"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            app:layout_constraintTop_toTopOf="@id/ivBankCardChip"
                            app:layout_constraintBottom_toBottomOf="@id/ivBankCardChip"
                            app:layout_constraintStart_toEndOf="@id/ivBankCardChip" />

                        <TextView
                            android:id="@+id/tvAccountNumber"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:text="****6888"
                            android:textColor="#0f172a"
                            android:textSize="20sp"
                            android:textStyle="bold"
                            android:letterSpacing="0.05"
                            app:layout_constraintTop_toBottomOf="@id/ivBankCardChip"
                            app:layout_constraintStart_toStartOf="parent" />

                        <TextView
                            android:id="@+id/tvAccountHolder"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="BUI DAI PHU"
                            android:textColor="#64748b"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            app:layout_constraintTop_toBottomOf="@id/tvAccountNumber"
                            app:layout_constraintStart_toStartOf="parent" />
                    </androidx.constraintlayout.widget.ConstraintLayout>

                    <LinearLayout
                        android:id="@+id/layoutNoBank"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="24dp"
                        android:visibility="gone">

                        <ImageView
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:src="@drawable/ic_lucide_alert_triangle"
                            app:tint="#ef4444" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:text="Chưa có tài khoản nhận tiền"
                            android:textColor="#ef4444"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="Bấm vào đây để liên kết ngay ngân hàng của bạn"
                            android:textColor="#3b82f6"
                            android:textSize="12sp" />
                    </LinearLayout>
                </FrameLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Amount Input Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardAmountInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@android:color/white"
                app:strokeWidth="1dp"
                app:strokeColor="#e2e8f0"
                app:layout_constraintTop_toBottomOf="@id/cardBankAccount"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="20dp">

                    <TextView
                        android:id="@+id/tvLabelInput"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="NHẬP SỐ TIỀN MUỐN RÚT"
                        android:textColor="#64748b"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.05"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintStart_toStartOf="parent" />

                    <!-- Input container layout -->
                    <LinearLayout
                        android:id="@+id/layoutInputArea"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        app:layout_constraintTop_toBottomOf="@id/tvLabelInput">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="đ"
                            android:textColor="#0f172a"
                            android:textSize="32sp"
                            android:textStyle="bold"
                            android:layout_marginEnd="8dp" />

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/tilAmount"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            app:hintEnabled="false"
                            app:boxBackgroundMode="none">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etAmount"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:background="@null"
                                android:hint="0"
                                android:textColorHint="#cbd5e1"
                                android:inputType="number"
                                android:textColor="#0f172a"
                                android:textSize="32sp"
                                android:textStyle="bold"
                                android:padding="0dp"
                                android:singleLine="true" />
                        </com.google.android.material.textfield.TextInputLayout>
                    </LinearLayout>

                    <View
                        android:id="@+id/dividerInput"
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="12dp"
                        android:background="#cbd5e1"
                        app:layout_constraintTop_toBottomOf="@id/layoutInputArea"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Số tiền rút tối thiểu là 50.000 đ"
                        android:textColor="#94a3b8"
                        android:textSize="12sp"
                        app:layout_constraintTop_toBottomOf="@id/dividerInput"
                        app:layout_constraintStart_toStartOf="parent" />
                </androidx.constraintlayout.widget.ConstraintLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Suggestions Label -->
            <TextView
                android:id="@+id/tvSuggestionsLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="Gợi ý số tiền nhanh"
                android:textColor="#475569"
                android:textSize="13sp"
                android:textStyle="bold"
                app:layout_constraintTop_toBottomOf="@id/cardAmountInput"
                app:layout_constraintStart_toStartOf="parent" />

            <!-- Outlined buttons for suggestions -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn100k"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_marginTop="12dp"
                android:layout_marginEnd="4dp"
                android:text="100K"
                android:textColor="#334155"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textAllCaps="false"
                android:padding="0dp"
                android:insetLeft="0dp"
                android:insetRight="0dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                app:strokeColor="#cbd5e1"
                app:strokeWidth="1dp"
                app:cornerRadius="12dp"
                app:rippleColor="#102563eb"
                app:layout_constraintTop_toBottomOf="@id/tvSuggestionsLabel"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toStartOf="@id/btn200k"
                app:layout_constraintHorizontal_chainStyle="spread" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn200k"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_marginHorizontal="4dp"
                android:text="200K"
                android:textColor="#334155"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textAllCaps="false"
                android:padding="0dp"
                android:insetLeft="0dp"
                android:insetRight="0dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                app:strokeColor="#cbd5e1"
                app:strokeWidth="1dp"
                app:cornerRadius="12dp"
                app:rippleColor="#102563eb"
                app:layout_constraintTop_toTopOf="@id/btn100k"
                app:layout_constraintStart_toEndOf="@id/btn100k"
                app:layout_constraintEnd_toStartOf="@id/btn500k" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn500k"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_marginHorizontal="4dp"
                android:text="500K"
                android:textColor="#334155"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textAllCaps="false"
                android:padding="0dp"
                android:insetLeft="0dp"
                android:insetRight="0dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                app:strokeColor="#cbd5e1"
                app:strokeWidth="1dp"
                app:cornerRadius="12dp"
                app:rippleColor="#102563eb"
                app:layout_constraintTop_toTopOf="@id/btn100k"
                app:layout_constraintStart_toEndOf="@id/btn200k"
                app:layout_constraintEnd_toStartOf="@id/btnMax" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnMax"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_marginStart="4dp"
                android:text="Rút hết"
                android:textColor="#2563eb"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textAllCaps="false"
                android:padding="0dp"
                android:insetLeft="0dp"
                android:insetRight="0dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                app:strokeColor="#bfdbfe"
                app:strokeWidth="1dp"
                app:cornerRadius="12dp"
                app:rippleColor="#102563eb"
                app:layout_constraintTop_toTopOf="@id/btn100k"
                app:layout_constraintStart_toEndOf="@id/btn500k"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- Disclaimer Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardInfoNote"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="#f8fafc"
                app:strokeWidth="1dp"
                app:strokeColor="#e2e8f0"
                app:layout_constraintTop_toBottomOf="@id/btn100k"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="12dp">

                    <ImageView
                        android:id="@+id/ivInfoIcon"
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:src="@drawable/ic_lucide_info"
                        app:tint="#64748b"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintStart_toStartOf="parent" />

                    <TextView
                        android:id="@+id/tvDisclaimer"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="[MOCK] Yêu cầu rút tiền được xử lý tự động trong vòng 5 giây nhờ cơ chế giả lập. Trong môi trường thực tế, giao dịch sẽ được chuyển đến ngân hàng liên kết trong vòng 24 giờ làm việc."
                        android:textColor="#64748b"
                        android:textSize="12sp"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintStart_toEndOf="@id/ivInfoIcon"
                        app:layout_constraintEnd_toEndOf="parent" />
                </androidx.constraintlayout.widget.ConstraintLayout>
            </com.google.android.material.card.MaterialCardView>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>

    <View
        android:id="@+id/bottomDivider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#e2e8f0"
        app:layout_constraintBottom_toTopOf="@id/layoutBottom"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Bottom Actions -->
    <FrameLayout
        android:id="@+id/layoutBottom"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/white"
        android:padding="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnConfirmWithdraw"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:text="Xác nhận rút tiền"
            android:textColor="@android:color/white"
            android:textSize="15sp"
            android:textStyle="bold"
            app:backgroundTint="#2563eb"
            app:cornerRadius="27dp"
            app:elevation="2dp" />
    </FrameLayout>

    <include
        android:id="@+id/layoutLoading"
        layout="@layout/layout_loading"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
