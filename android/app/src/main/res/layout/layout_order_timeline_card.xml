<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/FixIt.Card.Content"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="16dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <!-- ===== STEP 1 ===== -->
        <FrameLayout
            android:id="@+id/step1IconContainer"
            android:layout_width="20dp"
            android:layout_height="20dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <View
                android:id="@+id/step1Pulse"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:alpha="0.2"
                android:background="@drawable/circle_background"
                android:backgroundTint="#0ea5e9"
                android:visibility="gone" />

            <ImageView
                android:id="@+id/step1Icon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_lucide_check_circle"
                app:tint="#e2e8f0" />
        </FrameLayout>

        <View
            android:id="@+id/step1Line"
            android:layout_width="2dp"
            android:layout_height="30dp"
            android:background="#e2e8f0"
            app:layout_constraintEnd_toEndOf="@id/step1IconContainer"
            app:layout_constraintStart_toStartOf="@id/step1IconContainer"
            app:layout_constraintTop_toBottomOf="@id/step1IconContainer" />

        <TextView
            android:id="@+id/step1Title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:text="Đã nhận đơn"
            android:textColor="#0d1b2a"
            android:textSize="14sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toTopOf="@id/step1Time"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/step1IconContainer"
            app:layout_constraintTop_toTopOf="@id/step1IconContainer"
            app:layout_constraintVertical_chainStyle="packed" />

        <TextView
            android:id="@+id/step1Time"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text=""
            android:visibility="gone"
            android:textColor="#94a3b8"
            android:textSize="12sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="@id/step1Title"
            app:layout_constraintTop_toBottomOf="@id/step1Title" />

        <!-- ===== STEP 2 ===== -->
        <FrameLayout
            android:id="@+id/step2IconContainer"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginTop="4dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/step1Line">

            <View
                android:id="@+id/step2Pulse"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:alpha="0.2"
                android:background="@drawable/circle_background"
                android:backgroundTint="#0ea5e9"
                android:visibility="gone" />

            <ImageView
                android:id="@+id/step2Icon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_lucide_check_circle"
                app:tint="#e2e8f0" />
        </FrameLayout>

        <View
            android:id="@+id/step2Line"
            android:layout_width="2dp"
            android:layout_height="30dp"
            android:background="#e2e8f0"
            app:layout_constraintEnd_toEndOf="@id/step2IconContainer"
            app:layout_constraintStart_toStartOf="@id/step2IconContainer"
            app:layout_constraintTop_toBottomOf="@id/step2IconContainer" />

        <TextView
            android:id="@+id/step2Title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:text="Đang đến"
            android:textColor="#94a3b8"
            android:textSize="14sp"
            app:layout_constraintBottom_toTopOf="@id/step2Time"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/step2IconContainer"
            app:layout_constraintTop_toTopOf="@id/step2IconContainer"
            app:layout_constraintVertical_chainStyle="packed" />

        <TextView
            android:id="@+id/step2Time"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text=""
            android:visibility="gone"
            android:textColor="#94a3b8"
            android:textSize="12sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="@id/step2Title"
            app:layout_constraintTop_toBottomOf="@id/step2Title" />

        <!-- ===== STEP 3 ===== -->
        <FrameLayout
            android:id="@+id/step3IconContainer"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginTop="4dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/step2Line">

            <View
                android:id="@+id/step3Pulse"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:alpha="0.2"
                android:background="@drawable/circle_background"
                android:backgroundTint="#0ea5e9"
                android:visibility="gone" />

            <ImageView
                android:id="@+id/step3Icon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_lucide_check_circle"
                app:tint="#e2e8f0" />
        </FrameLayout>

        <View
            android:id="@+id/step3Line"
            android:layout_width="2dp"
            android:layout_height="30dp"
            android:background="#e2e8f0"
            app:layout_constraintEnd_toEndOf="@id/step3IconContainer"
            app:layout_constraintStart_toStartOf="@id/step3IconContainer"
            app:layout_constraintTop_toBottomOf="@id/step3IconContainer" />

        <TextView
            android:id="@+id/step3Title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:text="Khảo sát &amp; Báo giá"
            android:textColor="#94a3b8"
            android:textSize="14sp"
            app:layout_constraintBottom_toTopOf="@id/step3Time"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/step3IconContainer"
            app:layout_constraintTop_toTopOf="@id/step3IconContainer"
            app:layout_constraintVertical_chainStyle="packed" />

        <TextView
            android:id="@+id/step3Time"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text=""
            android:visibility="gone"
            android:textColor="#94a3b8"
            android:textSize="12sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="@id/step3Title"
            app:layout_constraintTop_toBottomOf="@id/step3Title" />

        <!-- ===== STEP 4 ===== -->
        <FrameLayout
            android:id="@+id/step4IconContainer"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginTop="4dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/step3Line">

            <View
                android:id="@+id/step4Pulse"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:alpha="0.2"
                android:background="@drawable/circle_background"
                android:backgroundTint="#0ea5e9"
                android:visibility="gone" />

            <ImageView
                android:id="@+id/step4Icon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_lucide_check_circle"
                app:tint="#e2e8f0" />
        </FrameLayout>

        <View
            android:id="@+id/step4Line"
            android:layout_width="2dp"
            android:layout_height="30dp"
            android:background="#e2e8f0"
            app:layout_constraintEnd_toEndOf="@id/step4IconContainer"
            app:layout_constraintStart_toStartOf="@id/step4IconContainer"
            app:layout_constraintTop_toBottomOf="@id/step4IconContainer" />

        <TextView
            android:id="@+id/step4Title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:text="Đang tiến hành sửa chữa"
            android:textColor="#94a3b8"
            android:textSize="14sp"
            app:layout_constraintBottom_toTopOf="@id/step4Time"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/step4IconContainer"
            app:layout_constraintTop_toTopOf="@id/step4IconContainer"
            app:layout_constraintVertical_chainStyle="packed" />

        <TextView
            android:id="@+id/step4Time"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text=""
            android:textColor="#94a3b8"
            android:textSize="12sp"
            android:visibility="gone"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="@id/step4Title"
            app:layout_constraintTop_toBottomOf="@id/step4Title" />

        <!-- ===== STEP 5 ===== -->
        <FrameLayout
            android:id="@+id/step5IconContainer"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginTop="4dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/step4Line">

            <View
                android:id="@+id/step5Pulse"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:alpha="0.2"
                android:background="@drawable/circle_background"
                android:backgroundTint="#0ea5e9"
                android:visibility="gone" />

            <ImageView
                android:id="@+id/step5Icon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_lucide_check_circle"
                app:tint="#e2e8f0" />
        </FrameLayout>

        <TextView
            android:id="@+id/step5Title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:text="Hoàn thành &amp; Bàn giao"
            android:textColor="#94a3b8"
            android:textSize="14sp"
            app:layout_constraintBottom_toTopOf="@id/step5Time"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/step5IconContainer"
            app:layout_constraintTop_toTopOf="@id/step5IconContainer"
            app:layout_constraintVertical_chainStyle="packed" />

        <TextView
            android:id="@+id/step5Time"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text=""
            android:textColor="#94a3b8"
            android:textSize="12sp"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="@id/step5Title"
            app:layout_constraintTop_toBottomOf="@id/step5Title" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>
