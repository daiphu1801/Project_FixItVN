<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingTop="8dp">

    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/ivReceivedAvatar"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:background="#E2E8F0"
        android:padding="4dp"
        android:src="@drawable/ic_person"
        android:scaleType="centerCrop"
        app:tint="#94A3B8"
        app:shapeAppearanceOverlay="@style/CircleImageView"
        app:layout_constraintBottom_toBottomOf="@id/tvReceivedMessage"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/tvReceivedMessage"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="60dp"
        android:background="@drawable/bg_message_received_bubble"
        android:maxWidth="280dp"
        android:paddingHorizontal="16dp"
        android:paddingVertical="10dp"
        android:text="Vâng, em hiểu rồi ạ. Khoảng 30 phút nữa em sẽ có mặt ở nhà chị để kiểm tra nhé!"
        android:textColor="#1E293B"
        android:textSize="15sp"
        app:layout_constraintStart_toEndOf="@id/ivReceivedAvatar"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tvReceivedTime"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginTop="4dp"
        android:text="14:22"
        android:textColor="#94A3B8"
        android:textSize="11sp"
        app:layout_constraintStart_toEndOf="@id/ivReceivedAvatar"
        app:layout_constraintTop_toBottomOf="@id/tvReceivedMessage" />

</androidx.constraintlayout.widget.ConstraintLayout>