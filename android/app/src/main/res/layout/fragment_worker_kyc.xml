<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#f0faff">

    <include
        android:id="@+id/appBarLayout"
        layout="@layout/layout_standard_appbar" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Progress Bar (Stepper) -->
            <com.google.android.material.card.MaterialCardView
                style="@style/FixIt.Card.Content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingVertical="16dp"
                    android:paddingHorizontal="24dp">

                    <!-- Step 1: KYC -->
                    <TextView
                        android:id="@+id/tvStep1Circle"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:background="@drawable/circle_background"
                        android:backgroundTint="#0ea5e9"
                        android:gravity="center"
                        android:text="1"
                        android:textColor="@android:color/white"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintStart_toStartOf="parent" />

                    <TextView
                        android:id="@+id/tvStep1Label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="KYC"
                        android:textColor="#0ea5e9"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        app:layout_constraintTop_toBottomOf="@id/tvStep1Circle"
                        app:layout_constraintStart_toStartOf="@id/tvStep1Circle"
                        app:layout_constraintEnd_toEndOf="@id/tvStep1Circle" />

                    <!-- Step 2: Đợi duyệt -->
                    <TextView
                        android:id="@+id/tvStep2Circle"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:background="@drawable/circle_background"
                        android:backgroundTint="#f1f5f9"
                        android:gravity="center"
                        android:text="2"
                        android:textColor="#94a3b8"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintEnd_toEndOf="parent" />

                    <TextView
                        android:id="@+id/tvStep2Label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Đợi duyệt"
                        android:textColor="#94a3b8"
                        android:textSize="12sp"
                        app:layout_constraintTop_toBottomOf="@id/tvStep2Circle"
                        app:layout_constraintStart_toStartOf="@id/tvStep2Circle"
                        app:layout_constraintEnd_toEndOf="@id/tvStep2Circle" />

                    <!-- Divider -->
                    <View
                        android:id="@+id/vStepDivider"
                        android:layout_width="0dp"
                        android:layout_height="2dp"
                        android:layout_marginHorizontal="16dp"
                        android:background="#e2e8f0"
                        app:layout_constraintTop_toTopOf="@id/tvStep1Circle"
                        app:layout_constraintBottom_toBottomOf="@id/tvStep1Circle"
                        app:layout_constraintStart_toEndOf="@id/tvStep1Circle"
                        app:layout_constraintEnd_toStartOf="@id/tvStep2Circle" />
                </androidx.constraintlayout.widget.ConstraintLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Tại sao cần xác minh -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardBackgroundColor="#e0f2fe"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp"
                        android:text="Tại sao cần xác minh?"
                        android:textColor="#0369a1"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Xác minh danh tính giúp xây dựng lòng tin với khách hàng và mở khóa tính năng rút tiền từ ví FixIt của bạn."
                        android:textColor="#075985"
                        android:textSize="14sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                style="@style/FixIt.Text.SectionHeader"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:text="Chọn loại giấy tờ xác minh" />

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                app:boxCornerRadiusBottomEnd="12dp"
                app:boxCornerRadiusBottomStart="12dp"
                app:boxCornerRadiusTopEnd="12dp"
                app:boxCornerRadiusTopStart="12dp"
                app:boxStrokeColor="#cbd5e1"
                app:hintEnabled="false">

                <AutoCompleteTextView
                    android:id="@+id/actvDocType"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="none"
                    android:paddingTop="16dp"
                    android:paddingBottom="16dp"
                    android:textColor="#0d1b2a"
                    android:textSize="16sp" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                style="@style/FixIt.Text.SectionHeader"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:text="Tải lên hình ảnh" />

            <!-- Row 1: Mặt trước & Mặt sau -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp">

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardUploadFront"
                    android:layout_width="0dp"
                    android:layout_height="120dp"
                    android:clickable="true"
                    android:focusable="true"
                    app:cardBackgroundColor="#f8fafc"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="0dp"
                    app:strokeColor="#cbd5e1"
                    app:strokeWidth="1dp"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toStartOf="@id/cardUploadBack"
                    app:layout_constraintHorizontal_chainStyle="spread"
                    android:layout_marginEnd="6dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="8dp">

                        <ImageView
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:layout_marginBottom="8dp"
                            android:src="@drawable/ic_lucide_clipboard_list"
                            app:tint="#64748b" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:text="Mặt trước"
                            android:textColor="#64748b"
                            android:textSize="13sp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardUploadBack"
                    android:layout_width="0dp"
                    android:layout_height="120dp"
                    android:clickable="true"
                    android:focusable="true"
                    app:cardBackgroundColor="#f8fafc"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="0dp"
                    app:strokeColor="#cbd5e1"
                    app:strokeWidth="1dp"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toEndOf="@id/cardUploadFront"
                    app:layout_constraintEnd_toEndOf="parent"
                    android:layout_marginStart="6dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="8dp">

                        <ImageView
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:layout_marginBottom="8dp"
                            android:src="@drawable/ic_lucide_clipboard_list"
                            app:tint="#64748b" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:text="Mặt sau"
                            android:textColor="#64748b"
                            android:textSize="13sp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- Row 2: Ảnh chân dung -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardUploadPortrait"
                android:layout_width="match_parent"
                android:layout_height="120dp"
                android:layout_marginBottom="24dp"
                android:clickable="true"
                android:focusable="true"
                app:cardBackgroundColor="#f8fafc"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                app:strokeColor="#cbd5e1"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical">

                    <ImageView
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:layout_marginBottom="8dp"
                        android:src="@drawable/ic_lucide_user"
                        app:tint="#64748b" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Chụp ảnh chân dung"
                        android:textColor="#64748b"
                        android:textSize="13sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Mẹo chụp ảnh rõ nét -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                app:cardBackgroundColor="#fff7ed"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/ic_lucide_info"
                            app:tint="#ea580c" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:text="Mẹo chụp ảnh rõ nét"
                            android:textColor="#ea580c"
                            android:textSize="15sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="• Đảm bảo đủ ánh sáng, không bị lóa\n• Giấy tờ nằm gọn trong khung hình\n• Các thông tin trên giấy tờ phải đọc được rõ ràng"
                        android:textColor="#9a3412"
                        android:textSize="14sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Spacer để đẩy nút Gửi xuống dưới cùng -->
            <View
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <!-- Nút Gửi xét duyệt -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSubmitKYC"
                style="@style/FixIt.Button.Action.Primary"
                android:layout_width="match_parent"
                android:layout_marginTop="16dp"
                android:text="Gửi xét duyệt" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
