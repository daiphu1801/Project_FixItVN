<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@android:color/white"
    android:paddingHorizontal="16dp"
    android:paddingVertical="12dp">

    <!-- Transaction Type Icon with Circular Background -->
    <ImageView
        android:id="@+id/ivTransactionIcon"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="@drawable/bg_circle_light_blue"
        android:padding="10dp"
        android:src="@drawable/ic_deposit_arrow"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Details Column -->
    <TextView
        android:id="@+id/tvTransactionTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="8dp"
        android:text="Nạp tiền vào ví"
        android:textColor="#0f172a"
        android:textSize="15sp"
        android:textStyle="bold"
        app:layout_constraintTop_toTopOf="@id/ivTransactionIcon"
        app:layout_constraintStart_toEndOf="@id/ivTransactionIcon"
        app:layout_constraintEnd_toStartOf="@id/tvTransactionAmount" />

    <TextView
        android:id="@+id/tvTransactionDate"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="15/05/2026 - 10:30"
        android:textColor="#64748b"
        android:textSize="12sp"
        app:layout_constraintTop_toBottomOf="@id/tvTransactionTitle"
        app:layout_constraintStart_toStartOf="@id/tvTransactionTitle" />

    <!-- Amount and Status Column -->
    <TextView
        android:id="@+id/tvTransactionAmount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="+ 500.000 đ"
        android:textColor="#22c55e"
        android:textSize="16sp"
        android:textStyle="bold"
        app:layout_constraintTop_toTopOf="@id/ivTransactionIcon"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/tvTransactionStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="Thành công"
        android:textColor="#64748b"
        android:textSize="11sp"
        app:layout_constraintTop_toBottomOf="@id/tvTransactionAmount"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
