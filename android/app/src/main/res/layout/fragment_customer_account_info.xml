<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8FAFC">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layoutHeader"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:background="#FFFFFF"
        android:paddingHorizontal="16dp"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/ivBack"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:padding="4dp"
            android:src="@drawable/ic_lucide_arrow_left"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="#0284C7" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Thông tin tài khoản"
            android:textColor="#0284C7"
            android:textSize="18sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/layoutHeader">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="20dp">

            <FrameLayout
                android:id="@+id/flAvatar"
                android:layout_width="100dp"
                android:layout_height="100dp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">
                <de.hdodenhof.circleimageview.CircleImageView
                    android:id="@+id/ivUserAvatar"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/ic_person"
                    app:civ_border_width="2dp"
                    app:civ_border_color="#0284C7" />
                <ImageView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_gravity="bottom|end"
                    android:background="@drawable/bg_circle_blue"
                    android:padding="6dp"
                    android:src="@drawable/ic_lucide_camera"
                    app:tint="#FFFFFF" />
            </FrameLayout>

            <TextView
                android:id="@+id/tvUserNameDisplay"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Đang tải..."
                android:textColor="#1E293B"
                android:textSize="18sp"
                android:textStyle="bold"
                app:layout_constraintTop_toBottomOf="@id/flAvatar"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <TextView
                android:id="@+id/tvMemberSince"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Thành viên từ 2023"
                android:textColor="#94A3B8"
                android:textSize="13sp"
                app:layout_constraintTop_toBottomOf="@id/tvUserNameDisplay"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <TextView 
                android:id="@+id/lblFullName"
                android:layout_width="wrap_content" 
                android:layout_height="wrap_content" 
                android:text="Họ và tên" 
                android:textColor="#64748B" 
                android:textSize="13sp" 
                android:layout_marginStart="4dp"
                android:layout_marginTop="24dp"
                app:layout_constraintTop_toBottomOf="@id/tvMemberSince"
                app:layout_constraintStart_toStartOf="parent" />

            <RelativeLayout 
                android:id="@+id/boxFullName"
                android:layout_width="0dp" 
                android:layout_height="52dp" 
                android:layout_marginTop="6dp" 
                android:background="@drawable/bg_input_selectable" 
                android:paddingHorizontal="16dp"
                app:layout_constraintTop_toBottomOf="@id/lblFullName"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">
                <EditText android:id="@+id/etFullName" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@null" android:text="Hoàng Minh" android:textColor="#1E293B" android:textSize="15sp" android:inputType="textPersonName" android:imeOptions="actionNext" android:layout_toStartOf="@id/editIcon1" />
                <ImageView android:id="@+id/editIcon1" android:layout_width="20dp" android:layout_height="20dp" android:layout_alignParentEnd="true" android:layout_centerVertical="true" android:src="@drawable/ic_lucide_edit" app:tint="#94A3B8" />
            </RelativeLayout>

            <TextView 
                android:id="@+id/lblPhone"
                android:layout_width="wrap_content" 
                android:layout_height="wrap_content" 
                android:text="Số điện thoại" 
                android:textColor="#64748B" 
                android:textSize="13sp" 
                android:layout_marginStart="4dp"
                android:layout_marginTop="16dp"
                app:layout_constraintTop_toBottomOf="@id/boxFullName"
                app:layout_constraintStart_toStartOf="parent"/>

            <RelativeLayout 
                android:id="@+id/boxPhone"
                android:layout_width="0dp" 
                android:layout_height="52dp" 
                android:layout_marginTop="6dp" 
                android:background="#F1F5F9" 
                android:paddingHorizontal="16dp"
                app:layout_constraintTop_toBottomOf="@id/lblPhone"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">
                <TextView android:id="@+id/tvPhone" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center_vertical" android:text="090 **** 123" android:textColor="#94A3B8" android:textSize="15sp" android:layout_toStartOf="@id/lockIcon" />
                <ImageView android:id="@+id/lockIcon" android:layout_width="20dp" android:layout_height="20dp" android:layout_alignParentEnd="true" android:layout_centerVertical="true" android:src="@drawable/ic_shield" app:tint="#CBD5E1" />
            </RelativeLayout>

            <TextView 
                android:id="@+id/lblEmail"
                android:layout_width="wrap_content" 
                android:layout_height="wrap_content" 
                android:text="Email" 
                android:textColor="#64748B" 
                android:textSize="13sp" 
                android:layout_marginStart="4dp"
                android:layout_marginTop="16dp"
                app:layout_constraintTop_toBottomOf="@id/boxPhone"
                app:layout_constraintStart_toStartOf="parent"/>

            <RelativeLayout 
                android:id="@+id/boxEmail"
                android:layout_width="0dp" 
                android:layout_height="52dp" 
                android:layout_marginTop="6dp" 
                android:background="@drawable/bg_input_selectable" 
                android:paddingHorizontal="16dp"
                app:layout_constraintTop_toBottomOf="@id/lblEmail"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">
                <EditText android:id="@+id/etEmail" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@null" android:text="hoangminh@example.com" android:textColor="#1E293B" android:textSize="15sp" android:inputType="textEmailAddress" android:imeOptions="actionDone" android:layout_toStartOf="@id/editIcon2" />
                <ImageView android:id="@+id/editIcon2" android:layout_width="20dp" android:layout_height="20dp" android:layout_alignParentEnd="true" android:layout_centerVertical="true" android:src="@drawable/ic_lucide_edit" app:tint="#94A3B8" />
            </RelativeLayout>

            <!-- Gender & DOB -->
            <TextView 
                android:id="@+id/lblGender"
                android:layout_width="wrap_content" 
                android:layout_height="wrap_content" 
                android:text="Giới tính" 
                android:textColor="#64748B" 
                android:textSize="13sp"
                android:layout_marginStart="4dp"
                android:layout_marginTop="16dp"
                app:layout_constraintTop_toBottomOf="@id/boxEmail"
                app:layout_constraintStart_toStartOf="parent"/>

            <RelativeLayout 
                android:id="@+id/boxGender"
                android:layout_width="0dp" 
                android:layout_height="52dp" 
                android:layout_marginTop="6dp" 
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_input_selectable" 
                android:paddingHorizontal="16dp"
                android:clickable="true"
                android:focusable="true"
                app:layout_constraintTop_toBottomOf="@id/lblGender"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toStartOf="@id/boxDob">
                <TextView
                    android:id="@+id/tvGenderValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:text="Nam"
                    android:textColor="#1E293B"
                    android:textSize="15sp" />
                <ImageView android:layout_width="16dp" android:layout_height="16dp" android:layout_alignParentEnd="true" android:layout_centerVertical="true" android:src="@drawable/ic_add" android:rotation="45" app:tint="#94A3B8" />
            </RelativeLayout>

            <TextView 
                android:id="@+id/lblDob"
                android:layout_width="wrap_content" 
                android:layout_height="wrap_content" 
                android:text="Ngày sinh" 
                android:textColor="#64748B" 
                android:textSize="13sp"
                android:layout_marginStart="8dp"
                android:layout_marginTop="16dp"
                app:layout_constraintTop_toBottomOf="@id/boxEmail"
                app:layout_constraintStart_toEndOf="@id/boxGender"/>

            <RelativeLayout 
                android:id="@+id/boxDob"
                android:layout_width="0dp" 
                android:layout_height="52dp" 
                android:layout_marginTop="6dp" 
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_input_selectable" 
                android:paddingHorizontal="16dp"
                android:clickable="true"
                android:focusable="true"
                app:layout_constraintTop_toBottomOf="@id/lblDob"
                app:layout_constraintStart_toEndOf="@id/boxGender"
                app:layout_constraintEnd_toEndOf="parent">
                <TextView
                    android:id="@+id/tvDobValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:text="15/05/1990"
                    android:textColor="#1E293B"
                    android:textSize="15sp" />
                <ImageView android:layout_width="18dp" android:layout_height="18dp" android:layout_alignParentEnd="true" android:layout_centerVertical="true" android:src="@drawable/ic_lucide_calendar" app:tint="#94A3B8" />
            </RelativeLayout>

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/boxWarning"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:background="@drawable/bg_info_warning"
                android:padding="12dp"
                app:layout_constraintTop_toBottomOf="@id/boxDob"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">
                
                <ImageView 
                    android:id="@+id/ivWarningIcon"
                    android:layout_width="20dp" 
                    android:layout_height="20dp" 
                    android:src="@drawable/ic_lucide_alert_triangle" 
                    app:tint="#D97706" 
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"/>
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:text="Để thay đổi số điện thoại, vui lòng liên hệ bộ phận hỗ trợ khách hàng để xác minh danh tính."
                    android:textColor="#92400E"
                    android:textSize="12sp" 
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toEndOf="@id/ivWarningIcon"
                    app:layout_constraintEnd_toEndOf="parent"/>
            </androidx.constraintlayout.widget.ConstraintLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSave"
                android:layout_width="0dp"
                android:layout_height="54dp"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="20dp"
                android:text="Lưu thay đổi"
                android:textAllCaps="false"
                android:textSize="16sp"
                android:textStyle="bold"
                app:cornerRadius="12dp"
                android:backgroundTint="#0284C7" 
                app:layout_constraintTop_toBottomOf="@id/boxWarning"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"/>

        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>