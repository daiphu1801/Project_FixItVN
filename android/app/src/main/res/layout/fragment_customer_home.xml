<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#F8FAFC">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="100dp">

            <!-- Header với gradient -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/layout_header"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_header_bottom_rounded"
                android:paddingHorizontal="20dp"
                android:paddingTop="52dp"
                android:paddingBottom="48dp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <!-- Greeting + Tên -->
                <TextView
                    android:id="@+id/tv_greeting"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="Xin chào, Minh 👋"
                    android:textColor="#CCE8FF"
                    android:textSize="13sp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintEnd_toStartOf="@id/iv_chat_icon"
                    android:layout_marginEnd="16dp" />

                <TextView
                    android:id="@+id/tv_role"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="Khách hàng"
                    android:textColor="#ffffff"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tv_greeting"
                    app:layout_constraintEnd_toStartOf="@id/iv_chat_icon"
                    android:layout_marginEnd="16dp"
                    android:layout_marginTop="2dp" />

                <!-- Notification Bell -->
                <ImageView
                    android:id="@+id/iv_chat_icon"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:src="@drawable/ic_lucide_bell"
                    android:padding="8dp"
                    android:background="@drawable/bg_circle_white"
                    app:tint="#42c2ff"
                    app:layout_constraintEnd_toStartOf="@id/iv_user_avatar"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    android:layout_marginEnd="10dp" />

                <!-- Avatar người dùng -->
                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/iv_user_avatar"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:src="@drawable/ic_lucide_user"
                    android:background="@drawable/bg_circle_white"
                    android:padding="8dp"
                    app:tint="#42c2ff"
                    app:strokeWidth="2dp"
                    app:strokeColor="#FFFFFF"
                    app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.App.CornerSize50Percent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- Search Bar nổi, clickable dẫn sang màn Search (id giữ nguyên card_location để binding Java) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_location"
                style="@style/FixIt.Card.Content"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_marginHorizontal="20dp"
                android:layout_marginTop="-28dp"
                app:cardElevation="8dp"
                app:layout_constraintTop_toBottomOf="@id/layout_header"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:paddingHorizontal="16dp">

                    <ImageView
                        android:id="@+id/iv_location_icon"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_lucide_search"
                        app:tint="#42c2ff"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent" />

                    <TextView
                        android:id="@+id/tv_location_label"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="Bạn cần sửa gì hôm nay?"
                        android:textSize="11sp"
                        android:textColor="#94A3B8"
                        android:layout_marginStart="10dp"
                        app:layout_constraintStart_toEndOf="@id/iv_location_icon"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toTopOf="@id/tv_location_value"
                        app:layout_constraintVertical_chainStyle="packed" />

                    <TextView
                        android:id="@+id/tv_location_value"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="Ví dụ: Sửa tủ lạnh, máy lạnh..."
                        android:textSize="13sp"
                        android:textColor="#0d1b2a"
                        android:textStyle="bold"
                        android:layout_marginStart="10dp"
                        app:layout_constraintStart_toEndOf="@id/iv_location_icon"
                        app:layout_constraintTop_toBottomOf="@id/tv_location_label"
                        app:layout_constraintBottom_toBottomOf="parent" />

                </androidx.constraintlayout.widget.ConstraintLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Banner khuyến mãi (ViewPager2 placeholder → hiện dùng card đơn) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_banner"
                android:layout_width="0dp"
                android:layout_height="150dp"
                android:layout_marginHorizontal="20dp"
                android:layout_marginTop="20dp"
                app:cardCornerRadius="20dp"
                app:cardElevation="4dp"
                app:strokeWidth="0dp"
                app:layout_constraintTop_toBottomOf="@id/card_location"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="#42c2ff"
                    android:padding="20dp">

                    <!-- Hình nền trang trí -->
                    <View
                        android:layout_width="130dp"
                        android:layout_height="130dp"
                        android:background="@drawable/bg_circle_white"
                        android:alpha="0.12"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent"
                        android:layout_marginEnd="-30dp"
                        android:layout_marginBottom="-30dp" />

                    <TextView
                        android:id="@+id/tv_banner_tag"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="#1a6fa3"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="3dp"
                        android:text="ƯU ĐÃI HÔM NAY"
                        android:textColor="#ffffff"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintStart_toStartOf="parent" />

                    <TextView
                        android:id="@+id/tv_banner_title"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="GIẢM 50K\nKHI ĐẶT THỢ!"
                        android:textColor="#ffffff"
                        android:textSize="26sp"
                        android:textStyle="bold"
                        android:lineSpacingExtra="2sp"
                        android:layout_marginTop="10dp"
                        android:layout_marginEnd="100dp"
                        app:layout_constraintTop_toBottomOf="@id/tv_banner_tag"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent" />

                    <TextView
                        android:id="@+id/tv_banner_sub"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Áp dụng đến 30/07"
                        android:textColor="#CCE8FF"
                        android:textSize="12sp"
                        android:layout_marginTop="6dp"
                        app:layout_constraintTop_toBottomOf="@id/tv_banner_title"
                        app:layout_constraintStart_toStartOf="parent" />

                    <ImageView
                        android:layout_width="88dp"
                        android:layout_height="88dp"
                        android:src="@drawable/ic_lucide_wrench"
                        app:tint="#ffffff"
                        android:alpha="0.25"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent" />

                </androidx.constraintlayout.widget.ConstraintLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Section: Đặt dịch vụ ngay -->
            <TextView
                android:id="@+id/tv_services_header"
                style="@style/FixIt.Text.SectionHeader"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="20dp"
                android:layout_marginTop="24dp"
                android:text="Đặt dịch vụ ngay"
                android:textSize="18sp"
                app:layout_constraintTop_toBottomOf="@id/card_banner"
                app:layout_constraintStart_toStartOf="parent" />

            <TextView
                android:id="@+id/tv_see_all"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="20dp"
                android:text="Xem tất cả →"
                android:textColor="#0284C7"
                android:textSize="13sp"
                android:textStyle="bold"
                app:layout_constraintBottom_toBottomOf="@id/tv_services_header"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@id/tv_services_header" />

            <!-- Grid dịch vụ -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_services"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="12dp"
                android:layout_marginTop="12dp"
                app:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
                app:spanCount="4"
                app:layout_constraintTop_toBottomOf="@id/tv_services_header"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:nestedScrollingEnabled="false" />

            <!-- Section: Ưu đãi -->
            <TextView
                android:id="@+id/tv_offers_header"
                style="@style/FixIt.Text.SectionHeader"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="20dp"
                android:layout_marginTop="28dp"
                android:text="Ưu đãi dành cho bạn"
                android:textSize="18sp"
                app:layout_constraintTop_toBottomOf="@id/rv_services"
                app:layout_constraintStart_toStartOf="parent" />

            <HorizontalScrollView
                android:id="@+id/scroll_offers"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:paddingHorizontal="20dp"
                android:clipToPadding="false"
                android:scrollbars="none"
                app:layout_constraintTop_toBottomOf="@id/tv_offers_header"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <include layout="@layout/item_customer_promo" />
                    <include layout="@layout/item_customer_promo" />
                    <include layout="@layout/item_customer_promo" />

                </LinearLayout>
            </HorizontalScrollView>

        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.core.widget.NestedScrollView>

    <include
        android:id="@+id/layoutLoading"
        layout="@layout/layout_loading"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

</FrameLayout>