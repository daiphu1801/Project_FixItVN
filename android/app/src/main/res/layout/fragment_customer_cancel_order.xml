<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F6F9"> <androidx.constraintlayout.widget.ConstraintLayout
    android:id="@+id/layoutHeader"
    android:layout_width="match_parent"
    android:layout_height="56dp"
    android:background="#FFFFFF"
    android:elevation="2dp"
    app:layout_constraintTop_toTopOf="parent">

    <ImageView
        android:id="@+id/ivBack"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginStart="8dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:padding="8dp"
        android:src="@drawable/ic_lucide_arrow_left"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="#1E293B" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Hủy đơn dịch vụ"
        android:textColor="#1E293B"
        android:textSize="16sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toTopOf="@id/layoutBottomAction"
        app:layout_constraintTop_toBottomOf="@id/layoutHeader">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/warningBox"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_warning_light"
                android:padding="16dp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <ImageView
                    android:id="@+id/ivWarningIcon"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_lucide_alert_triangle"
                    app:tint="#D97706" 
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:text="Việc hủy đơn liên tục có thể ảnh hưởng đến trải nghiệm của bạn sau này."
                    android:textColor="#B45309"
                    android:textSize="13sp" 
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toEndOf="@id/ivWarningIcon"
                    app:layout_constraintEnd_toEndOf="parent" />
            </androidx.constraintlayout.widget.ConstraintLayout>

            <TextView
                android:id="@+id/tvWorkerTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="8dp"
                android:text="VẤN ĐỀ TỪ PHÍA THỢ"
                android:textColor="#475569"
                android:textSize="12sp"
                android:textStyle="bold" 
                app:layout_constraintTop_toBottomOf="@id/warningBox"
                app:layout_constraintStart_toStartOf="parent"/>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardWorkerReasons"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                app:layout_constraintTop_toBottomOf="@id/tvWorkerTitle"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <RadioGroup
                    android:id="@+id/rgReasonWorker"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <RadioButton
                        android:id="@+id/rbWorker1"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:button="@null"
                        android:drawableEnd="@drawable/selector_radio_button"
                        android:paddingHorizontal="16dp"
                        android:text="Tôi không muốn thợ này"
                        android:textColor="#334155"
                        android:textSize="14sp" />

                    <RadioButton
                        android:id="@+id/rbWorker2"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:button="@null"
                        android:drawableEnd="@drawable/selector_radio_button"
                        android:paddingHorizontal="16dp"
                        android:text="Thời gian chờ thợ đến quá lâu"
                        android:textColor="#334155"
                        android:textSize="14sp" />

                    <RadioButton
                        android:id="@+id/rbWorker3"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:button="@null"
                        android:drawableEnd="@drawable/selector_radio_button"
                        android:paddingHorizontal="16dp"
                        android:text="Không thể liên lạc được với thợ"
                        android:textColor="#334155"
                        android:textSize="14sp" />
                </RadioGroup>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:id="@+id/tvCustomerTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="8dp"
                android:text="THAY ĐỔI TỪ PHÍA TÔI"
                android:textColor="#475569"
                android:textSize="12sp"
                android:textStyle="bold" 
                app:layout_constraintTop_toBottomOf="@id/cardWorkerReasons"
                app:layout_constraintStart_toStartOf="parent"/>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardCustomerReasons"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                app:layout_constraintTop_toBottomOf="@id/tvCustomerTitle"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <RadioGroup
                    android:id="@+id/rgReasonCustomer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <RadioButton
                        android:id="@+id/rbCustomer1"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:button="@null"
                        android:drawableEnd="@drawable/selector_radio_button"
                        android:paddingHorizontal="16dp"
                        android:text="Tôi đã tự khắc phục được vấn đề"
                        android:textColor="#334155"
                        android:textSize="14sp" />

                    <RadioButton
                        android:id="@+id/rbCustomer2"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:button="@null"
                        android:drawableEnd="@drawable/selector_radio_button"
                        android:paddingHorizontal="16dp"
                        android:text="Tôi đặt nhầm dịch vụ / Sai địa chỉ"
                        android:textColor="#334155"
                        android:textSize="14sp" />

                    <RadioButton
                        android:id="@+id/rbCustomer3"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:button="@null"
                        android:drawableEnd="@drawable/selector_radio_button"
                        android:paddingHorizontal="16dp"
                        android:text="Tôi có việc bận đột xuất"
                        android:textColor="#334155"
                        android:textSize="14sp" />

                    <RadioButton
                        android:id="@+id/rbCustomerOther"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:button="@null"
                        android:drawableEnd="@drawable/selector_radio_button"
                        android:paddingHorizontal="16dp"
                        android:text="Lý do khác"
                        android:textColor="#334155"
                        android:textSize="14sp" />
                </RadioGroup>
            </com.google.android.material.card.MaterialCardView>

            <EditText
                android:id="@+id/etOtherReason"
                android:layout_width="0dp"
                android:layout_height="100dp"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="24dp"
                android:background="@drawable/bg_input_border"
                android:gravity="top|start"
                android:hint="Nhập lý do khác của bạn (tùy chọn)..."
                android:padding="16dp"
                android:textColorHint="#94A3B8"
                android:textSize="14sp" 
                app:layout_constraintTop_toBottomOf="@id/cardCustomerReasons"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"/>

        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layoutBottomAction"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FFFFFF"
        android:elevation="16dp"
        android:padding="16dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnKeepOrder"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_marginEnd="12dp"
            android:text="Giữ lại đơn"
            android:textColor="#0EA5E9"
            android:textStyle="bold"
            app:cornerRadius="12dp"
            app:strokeColor="#BAE6FD"
            app:strokeWidth="1.5dp" 
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/btnConfirmCancel"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnConfirmCancel"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:backgroundTint="#EF4444"
            android:text="Xác nhận hủy"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            app:cornerRadius="12dp" 
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toEndOf="@id/btnKeepOrder"
            app:layout_constraintEnd_toEndOf="parent"/>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <include
        android:id="@+id/layoutLoading"
        layout="@layout/layout_loading"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />
</androidx.constraintlayout.widget.ConstraintLayout>