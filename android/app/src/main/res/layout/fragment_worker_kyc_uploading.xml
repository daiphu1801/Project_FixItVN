<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#f0faff">

    <!-- AppBar (Toolbar) ở trên cùng -->
    <include
        android:id="@+id/appBarLayout"
        layout="@layout/layout_standard_appbar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Card chỉ số Tiến trình (Stepper) -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardStepper"
        style="@style/FixIt.Card.Content"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginHorizontal="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/appBarLayout">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingVertical="16dp"
            android:paddingHorizontal="32dp">

            <!-- Step 1: KYC (Done) -->
            <ImageView
                android:id="@+id/ivStep1Done"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/circle_background"
                android:backgroundTint="#22c55e"
                android:padding="6dp"
                android:src="@drawable/ic_lucide_check_circle"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:tint="@android:color/white" />

            <TextView
                android:id="@+id/tvStep1Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="KYC"
                android:textColor="#22c55e"
                android:textSize="12sp"
                android:textStyle="bold"
                app:layout_constraintTop_toBottomOf="@id/ivStep1Done"
                app:layout_constraintStart_toStartOf="@id/ivStep1Done"
                app:layout_constraintEnd_toEndOf="@id/ivStep1Done" />

            <!-- Step 2: Tải hồ sơ (Active) -->
            <TextView
                android:id="@+id/tvStep2Circle"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="@drawable/circle_background"
                android:backgroundTint="#0ea5e9"
                android:gravity="center"
                android:text="2"
                android:textColor="@android:color/white"
                android:textSize="14sp"
                android:textStyle="bold"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <TextView
                android:id="@+id/tvStep2Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Tải hồ sơ"
                android:textColor="#0ea5e9"
                android:textSize="12sp"
                android:textStyle="bold"
                app:layout_constraintTop_toBottomOf="@id/tvStep2Circle"
                app:layout_constraintStart_toStartOf="@id/tvStep2Circle"
                app:layout_constraintEnd_toEndOf="@id/tvStep2Circle" />

            <!-- Step 3: Đợi duyệt (Inactive) -->
            <TextView
                android:id="@+id/tvStep3Circle"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/circle_background"
                android:backgroundTint="#e2e8f0"
                android:gravity="center"
                android:text="3"
                android:textColor="#94a3b8"
                android:textSize="14sp"
                android:textStyle="bold"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <TextView
                android:id="@+id/tvStep3Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Đợi duyệt"
                android:textColor="#94a3b8"
                android:textSize="12sp"
                app:layout_constraintTop_toBottomOf="@id/tvStep3Circle"
                app:layout_constraintStart_toStartOf="@id/tvStep3Circle"
                app:layout_constraintEnd_toEndOf="@id/tvStep3Circle" />

            <!-- Thanh nối 1 (Step 1 -> Step 2) -->
            <View
                android:id="@+id/vStepDivider1"
                android:layout_width="0dp"
                android:layout_height="2dp"
                android:layout_marginHorizontal="8dp"
                android:background="#22c55e"
                app:layout_constraintTop_toTopOf="@id/ivStep1Done"
                app:layout_constraintBottom_toBottomOf="@id/ivStep1Done"
                app:layout_constraintStart_toEndOf="@id/ivStep1Done"
                app:layout_constraintEnd_toStartOf="@id/tvStep2Circle" />

            <!-- Thanh nối 2 (Step 2 -> Step 3) -->
            <View
                android:id="@+id/vStepDivider2"
                android:layout_width="0dp"
                android:layout_height="2dp"
                android:layout_marginHorizontal="8dp"
                android:background="#e2e8f0"
                app:layout_constraintTop_toTopOf="@id/tvStep2Circle"
                app:layout_constraintBottom_toBottomOf="@id/tvStep2Circle"
                app:layout_constraintStart_toEndOf="@id/tvStep2Circle"
                app:layout_constraintEnd_toStartOf="@id/tvStep3Circle" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Khu vực progress xoay tròn và text tiêu đề -->
    <com.google.android.material.progressindicator.CircularProgressIndicator
        android:id="@+id/progressUploading"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:layout_marginTop="24dp"
        android:indeterminate="true"
        app:indicatorColor="#0ea5e9"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/cardStepper"
        app:trackThickness="4dp" />

    <TextView
        android:id="@+id/tvUploadingTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Đang tải hồ sơ lên"
        android:textColor="#0d1b2a"
        android:textSize="20sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/progressUploading" />

    <TextView
        android:id="@+id/tvUploadingSubtitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginHorizontal="32dp"
        android:gravity="center"
        android:text="Vui lòng giữ kết nối mạng ổn định.\nHồ sơ của bạn đang được tải lên hệ thống..."
        android:textColor="#64748b"
        android:textSize="14sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvUploadingTitle" />

    <!-- Card tiến trình chi tiết của 3 ảnh -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardProgressDetail"
        style="@style/FixIt.Card.Content"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:layout_marginHorizontal="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvUploadingSubtitle">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp">

            <TextView
                android:id="@+id/tvCardTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Chi tiết tiến trình"
                android:textColor="#0d1b2a"
                android:textSize="16sp"
                android:textStyle="bold"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <!-- Ảnh mặt trước -->
            <ImageView
                android:id="@+id/ivStatusFront"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginTop="16dp"
                android:src="@drawable/ic_lucide_timer"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tvCardTitle"
                app:tint="#0ea5e9" />

            <TextView
                android:id="@+id/tvLabelFront"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:text="Ảnh mặt trước CCCD"
                android:textColor="#0d1b2a"
                android:textSize="14sp"
                app:layout_constraintBottom_toBottomOf="@id/ivStatusFront"
                app:layout_constraintEnd_toStartOf="@id/tvStatusFront"
                app:layout_constraintStart_toEndOf="@id/ivStatusFront"
                app:layout_constraintTop_toTopOf="@id/ivStatusFront" />

            <TextView
                android:id="@+id/tvStatusFront"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Đang xử lý..."
                android:textColor="#0ea5e9"
                android:textSize="13sp"
                app:layout_constraintBottom_toBottomOf="@id/ivStatusFront"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@id/ivStatusFront" />

            <View
                android:id="@+id/dividerFront"
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_marginTop="8dp"
                android:background="#e2e8f0"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/ivStatusFront" />

            <!-- Ảnh mặt sau -->
            <ImageView
                android:id="@+id/ivStatusBack"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginTop="8dp"
                android:src="@drawable/ic_lucide_timer"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/dividerFront"
                app:tint="#0ea5e9" />

            <TextView
                android:id="@+id/tvLabelBack"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:text="Ảnh mặt sau CCCD"
                android:textColor="#0d1b2a"
                android:textSize="14sp"
                app:layout_constraintBottom_toBottomOf="@id/ivStatusBack"
                app:layout_constraintEnd_toStartOf="@id/tvStatusBack"
                app:layout_constraintStart_toEndOf="@id/ivStatusBack"
                app:layout_constraintTop_toTopOf="@id/ivStatusBack" />

            <TextView
                android:id="@+id/tvStatusBack"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Đang xử lý..."
                android:textColor="#0ea5e9"
                android:textSize="13sp"
                app:layout_constraintBottom_toBottomOf="@id/ivStatusBack"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@id/ivStatusBack" />

            <View
                android:id="@+id/dividerBack"
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_marginTop="8dp"
                android:background="#e2e8f0"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/ivStatusBack" />

            <!-- Ảnh chân dung -->
            <ImageView
                android:id="@+id/ivStatusPortrait"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginTop="8dp"
                android:src="@drawable/ic_lucide_timer"
                app:layout_constraintBottom_toTopOf="@id/barrierBottom"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/dividerBack"
                app:tint="#0ea5e9" />

            <TextView
                android:id="@+id/tvLabelPortrait"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:text="Ảnh chân dung"
                android:textColor="#0d1b2a"
                android:textSize="14sp"
                app:layout_constraintBottom_toBottomOf="@id/ivStatusPortrait"
                app:layout_constraintEnd_toStartOf="@id/tvStatusPortrait"
                app:layout_constraintStart_toEndOf="@id/ivStatusPortrait"
                app:layout_constraintTop_toTopOf="@id/ivStatusPortrait" />

            <TextView
                android:id="@+id/tvStatusPortrait"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Đang xử lý..."
                android:textColor="#0ea5e9"
                android:textSize="13sp"
                app:layout_constraintBottom_toBottomOf="@id/ivStatusPortrait"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@id/ivStatusPortrait" />

            <androidx.constraintlayout.widget.Barrier
                android:id="@+id/barrierBottom"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:barrierDirection="bottom"
                app:constraint_referenced_ids="ivStatusPortrait,tvLabelPortrait,tvStatusPortrait" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Card lỗi (Ẩn mặc định) -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardError"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginHorizontal="16dp"
        android:visibility="gone"
        app:cardBackgroundColor="#fef2f2"
        app:strokeColor="#fee2e2"
        app:strokeWidth="1dp"
        app:cardCornerRadius="12dp"
        app:cardElevation="0dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/cardProgressDetail">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="16dp">

            <TextView
                android:id="@+id/tvErrorMessage"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Tải lên thất bại. Vui lòng kiểm tra lại kết nối mạng."
                android:textColor="#991b1b"
                android:textSize="14sp" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Nút thử lại (Ẩn mặc định) -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnRetryUpload"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:layout_marginTop="16dp"
        android:layout_marginHorizontal="16dp"
        android:text="Thử lại"
        android:visibility="gone"
        android:textColor="@android:color/white"
        app:backgroundTint="#0ea5e9"
        app:cornerRadius="12dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/cardError" />

    <!-- Ghi chú chân trang, neo ở sát đáy -->
    <TextView
        android:id="@+id/tvNote"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="32dp"
        android:layout_marginHorizontal="32dp"
        android:gravity="center"
        android:text="Bạn có thể rời khỏi màn hình này.\nTác vụ sẽ tiếp tục chạy ngầm trong nền cho đến khi hoàn thành."
        android:textColor="#64748b"
        android:textSize="12sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
