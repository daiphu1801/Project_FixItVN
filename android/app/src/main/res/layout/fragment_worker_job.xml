<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#f0faff"
    android:orientation="vertical">

    <!-- ═══════════════════════════════════════════════
         HEADER: Avatar + Tên thợ + Chuông thông báo
         ═══════════════════════════════════════════════ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/white"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingVertical="12dp">

        <ImageView
            android:id="@+id/ivJobAvatar"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginEnd="10dp"
            android:background="@drawable/circle_background"
            android:padding="8dp"
            android:src="@drawable/ic_lucide_user"
            app:tint="#42c2ff" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Bảng điều khiển"
                android:textColor="#94a3b8"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/tvJobWorkerName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Nguyễn Văn Phú"
                android:textColor="#0d1b2a"
                android:textSize="16sp"
                android:textStyle="bold"
                tools:ignore="HardcodedText" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">

            <ImageView
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:src="@drawable/ic_lucide_bell"
                app:tint="#42c2ff" />

            <View
                android:layout_width="9dp"
                android:layout_height="9dp"
                android:layout_gravity="top|end"
                android:background="#ef4444" />
        </FrameLayout>
    </LinearLayout>

    <!-- ═══════════════════════════════════════════════
         BẢN ĐỒ PLACEHOLDER — 60% phần còn lại
         ═══════════════════════════════════════════════ -->
    <FrameLayout
        android:id="@+id/frameMapPlaceholder"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="6"
        android:background="#cbe8f8">

        <!-- Đường kẻ ngang giả bản đồ -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_gravity="center_vertical"
            android:alpha="0.5"
            android:background="#b0d9f0" />

        <!-- Đường kẻ dọc giả bản đồ -->
        <View
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:layout_gravity="center_horizontal"
            android:alpha="0.5"
            android:background="#b0d9f0" />

        <!-- Nhãn khu vực -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|start"
            android:layout_margin="12dp"
            android:background="#cc42c2ff"
            android:paddingHorizontal="10dp"
            android:paddingVertical="5dp"
            android:text="📍 Cầu Giấy, Hà Nội"
            android:textColor="#ffffff"
            android:textSize="12sp"
            android:textStyle="bold" />

        <!-- Icon Radar + trạng thái -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/ivMapRadar"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:src="@drawable/ic_lucide_radar"
                app:tint="#42c2ff" />

            <TextView
                android:id="@+id/tvMapStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="#cc42c2ff"
                android:paddingHorizontal="14dp"
                android:paddingVertical="5dp"
                android:text="Đang tắt"
                android:textColor="#ffffff"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- Overlay mờ khi Offline -->
        <View
            android:id="@+id/viewMapOverlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#66000000"
            android:visibility="visible" />
    </FrameLayout>

    <!-- ═══════════════════════════════════════════════
         BANNER CẢNH BÁO NỢ
         ═══════════════════════════════════════════════ -->
    <LinearLayout
        android:id="@+id/bannerDebt"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#fef2f2"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingVertical="10dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:text="⚠️"
            android:textSize="16sp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Bạn đang có khoản nợ chiết khấu. Vui lòng nạp tiền trước khi nhận việc."
            android:textColor="#b91c1c"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/btnGoToWalletFromJob"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="#ef4444"
            android:clickable="true"
            android:focusable="true"
            android:paddingHorizontal="12dp"
            android:paddingVertical="6dp"
            android:text="Nạp tiền"
            android:textColor="#ffffff"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- ═══════════════════════════════════════════════
         PANEL ĐIỀU KHIỂN — 40% phần còn lại (scrollable)
         ═══════════════════════════════════════════════ -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="4"
        android:clipToPadding="false"
        android:paddingBottom="100dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Card trạng thái Online/Offline -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardBackgroundColor="#f1f5f9"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeColor="#e2e8f0"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="16dp">

                    <View
                        android:id="@+id/viewStatusDot"
                        android:layout_width="12dp"
                        android:layout_height="12dp"
                        android:layout_marginEnd="12dp"
                        android:background="#94a3b8" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvStatusLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="OFFLINE"
                            android:textColor="#94a3b8"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvStatusDesc"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Bạn đang không hiển thị trên bản đồ"
                            android:textColor="#64748b"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvServiceArea"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Cầu Giấy ▾"
                        android:textColor="#42c2ff"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Nút Toggle -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnToggleOnline"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginBottom="14dp"
                android:text="BẮT ĐẦU NHẬN VIỆC"
                android:textSize="15sp"
                android:textStyle="bold"
                app:backgroundTint="#22c55e"
                app:cornerRadius="16dp"
                app:elevation="4dp"
                app:icon="@drawable/ic_lucide_radar"
                app:iconGravity="textStart"
                app:iconPadding="10dp" />

            <!-- 2 Stats mini -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    app:cardBackgroundColor="@android:color/white"
                    app:cardCornerRadius="14dp"
                    app:cardElevation="2dp"
                    app:strokeColor="#e2e8f0"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="14dp">

                        <ImageView
                            android:layout_width="26dp"
                            android:layout_height="26dp"
                            android:layout_marginBottom="6dp"
                            android:src="@drawable/ic_lucide_briefcase"
                            app:tint="#42c2ff" />

                        <TextView
                            android:id="@+id/tvTodayOrders"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="5"
                            android:textColor="#0d1b2a"
                            android:textSize="22sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Đơn hôm nay"
                            android:textColor="#94a3b8"
                            android:textSize="11sp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    app:cardBackgroundColor="@android:color/white"
                    app:cardCornerRadius="14dp"
                    app:cardElevation="2dp"
                    app:strokeColor="#e2e8f0"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="14dp">

                        <ImageView
                            android:layout_width="26dp"
                            android:layout_height="26dp"
                            android:layout_marginBottom="6dp"
                            android:src="@drawable/ic_lucide_check_circle"
                            app:tint="#f59e0b" />

                        <TextView
                            android:id="@+id/tvRatingScore"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="4.8"
                            android:textColor="#0d1b2a"
                            android:textSize="22sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Điểm đánh giá"
                            android:textColor="#94a3b8"
                            android:textSize="11sp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</LinearLayout>
