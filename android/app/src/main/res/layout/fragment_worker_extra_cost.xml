<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#f9fafb"
    android:orientation="vertical">

    <!-- TOPBAR -->
    <include
        android:id="@+id/llWorkerTopbar"
        layout="@layout/layout_worker_topbar" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                style="@style/FixIt.Text.SectionHeader"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Báo giá phát sinh"
                android:textSize="20sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Thêm các hạng mục linh kiện hoặc dịch vụ phát sinh trong quá trình sửa chữa."
                android:textColor="#6b7280"
                android:textSize="13sp"
                android:layout_marginBottom="20dp" />

            <!-- List of items -->
            <LinearLayout
                android:id="@+id/llItemsContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                <!-- item_extra_cost will be added here -->
            </LinearLayout>

            <!-- Add Item Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAddItem"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="8dp"
                android:text="Thêm hạng mục mới"
                android:textAllCaps="false"
                android:textColor="#0ea5e9"
                app:icon="@drawable/ic_lucide_edit"
                app:iconTint="#0ea5e9"
                app:strokeColor="#0ea5e9" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginVertical="24dp"
                android:background="#e5e7eb" />

            <!-- Reason -->
            <TextView
                style="@style/FixIt.Text.SectionHeader"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Lý do phát sinh"
                android:textSize="15sp" />

            <EditText
                android:id="@+id/etExtraReason"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_input_field"
                android:gravity="top"
                android:hint="VD: Phát hiện hỏng hóc sâu hơn, cần thay thêm tụ điện..."
                android:inputType="textMultiLine"
                android:minLines="3"
                android:padding="12dp"
                android:textSize="14sp" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Summary & Footer -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="#ffffff"
        app:cardCornerRadius="0dp"
        app:cardElevation="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Tổng chi phí phát sinh:"
                    android:textColor="#374151"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/tvTotalExtra"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0 đ"
                    android:textColor="#0ea5e9"
                    android:textSize="18sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSubmitExtra"
                style="@style/FixIt.Button.Action.Primary"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="Gửi báo giá cho khách"
                android:textAllCaps="false"
                android:textStyle="bold"
                app:backgroundTint="#0ea5e9" />

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

</LinearLayout>
