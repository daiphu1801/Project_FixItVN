<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8FAFC">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/headerLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_header_bottom_rounded"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="44dp"
        android:paddingBottom="16dp"
        android:clipToPadding="false"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:src="@drawable/ic_arrow_back"
            android:background="@drawable/bg_circle_white"
            android:padding="8dp"
            app:tint="#42c2ff"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>

        <TextView
            android:id="@+id/tvHeaderTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:text="Đặt dịch vụ"
            android:textColor="@color/white"
            android:textSize="20sp"
            android:textStyle="bold"
            app:layout_constraintTop_toTopOf="@id/btnBack"
            app:layout_constraintBottom_toBottomOf="@id/btnBack"
            app:layout_constraintStart_toEndOf="@id/btnBack"
            app:layout_constraintEnd_toEndOf="parent"/>

        <TextView
            android:id="@+id/tvHeaderSubtitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginTop="2dp"
            android:text="Điền thông tin để tìm thợ phù hợp"
            android:textColor="#CCE8FF"
            android:textSize="13sp"
            app:layout_constraintTop_toBottomOf="@id/btnBack"
            app:layout_constraintStart_toEndOf="@id/btnBack"
            app:layout_constraintEnd_toEndOf="parent"/>

        <!-- Step indicator -->
        <LinearLayout
            android:id="@+id/layoutStepIndicator"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="14dp"
            app:layout_constraintTop_toBottomOf="@id/tvHeaderSubtitle"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <TextView
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:text="1"
                android:textColor="#42c2ff"
                android:textSize="12sp"
                android:textStyle="bold"
                android:gravity="center"
                android:background="@drawable/bg_circle_white" />
            <View android:layout_width="24dp" android:layout_height="2dp" android:background="#CCE8FF" android:layout_marginHorizontal="4dp"/>
            <TextView
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:text="2"
                android:textColor="#CCE8FF"
                android:textSize="12sp"
                android:textStyle="bold"
                android:gravity="center"
                android:background="@drawable/bg_circle_white"
                android:alpha="0.5" />
            <View android:layout_width="24dp" android:layout_height="2dp" android:background="#CCE8FF" android:layout_marginHorizontal="4dp"/>
            <TextView
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:text="3"
                android:textColor="#CCE8FF"
                android:textSize="12sp"
                android:textStyle="bold"
                android:gravity="center"
                android:background="@drawable/bg_circle_white"
                android:alpha="0.5" />
        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <LinearLayout
        android:id="@+id/bottomActionLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/white"
        android:paddingHorizontal="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="20dp"
        android:elevation="8dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <!-- Tóm tắt đơn dịch vụ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="12dp"
            android:background="#F8FAFC"
            android:padding="12dp"
            android:gravity="center_vertical">
            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_lucide_wrench"
                app:tint="#0284C7" />
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="12dp">
                <TextView
                    android:id="@+id/tvSummaryService"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Sửa máy lạnh"
                    android:textStyle="bold"
                    android:textColor="#0f172a"
                    android:textSize="14sp" />
                <TextView
                    android:id="@+id/tvSummaryTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Ngay bây giờ"
                    android:textColor="#64748B"
                    android:textSize="12sp" />
            </LinearLayout>
            <TextView
                android:id="@+id/tvSummaryPrice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Khảo sát báo giá"
                android:textColor="#16A34A"
                android:textStyle="bold"
                android:textSize="13sp" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="56dp">
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnFindWorker"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:text="Tìm thợ ngay"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textAllCaps="false"
                app:backgroundTint="#42C2FF"
                app:cornerRadius="16dp" />
            <ProgressBar
                android:id="@+id/pbFindWorker"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:indeterminateTint="@color/white"
                android:visibility="gone" />
        </FrameLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="8dp"
            android:text="🛡️ Bảo đảm bởi FixIt — Hoàn tiền nếu không hài lòng"
            android:textColor="#64748B"
            android:textSize="11sp" />

    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingBottom="20dp"
        app:layout_constraintTop_toBottomOf="@id/headerLayout"
        app:layout_constraintBottom_toTopOf="@id/bottomActionLayout">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardProblem"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeWidth="1dp"
                app:strokeColor="#F1F5F9"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="16dp">

                    <FrameLayout
                        android:id="@+id/ivProblemContainer"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@drawable/bg_circle_light_blue"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent">
                        <ImageView
                            android:id="@+id/ivProblem"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_person"
                            app:tint="#0284c7" />
                    </FrameLayout>

                    <TextView
                        android:id="@+id/tvProblemTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:text="Vấn đề của bạn *"
                        android:textColor="#1E293B"
                        android:textSize="15sp"
                        android:textStyle="bold" 
                        app:layout_constraintTop_toTopOf="@id/ivProblemContainer"
                        app:layout_constraintBottom_toTopOf="@id/tvProblemDesc"
                        app:layout_constraintStart_toEndOf="@id/ivProblemContainer"
                        app:layout_constraintEnd_toStartOf="@id/ivProblemArrow"
                        app:layout_constraintVertical_chainStyle="packed"/>

                    <TextView
                        android:id="@+id/tvProblemDesc"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:text="Mô tả chi tiết vấn đề đang gặp"
                        android:textColor="#64748B"
                        android:textSize="13sp" 
                        app:layout_constraintTop_toBottomOf="@id/tvProblemTitle"
                        app:layout_constraintBottom_toBottomOf="@id/ivProblemContainer"
                        app:layout_constraintStart_toEndOf="@id/ivProblemContainer"
                        app:layout_constraintEnd_toStartOf="@id/ivProblemArrow"/>

                    <ImageView
                        android:id="@+id/ivProblemArrow"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_arrow_right"
                        app:tint="#94A3B8" 
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardLocation"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeWidth="1dp"
                app:strokeColor="#F1F5F9"
                app:layout_constraintTop_toBottomOf="@id/cardProblem"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="16dp">

                    <FrameLayout
                        android:id="@+id/ivLocationContainer"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@drawable/bg_circle_light_blue"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintStart_toStartOf="parent">
                        <ImageView
                            android:id="@+id/ivLocation"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_location"
                            app:tint="#0284c7" />
                    </FrameLayout>

                    <TextView
                        android:id="@+id/tvLocationBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:background="@drawable/bg_badge_gray"
                        android:paddingHorizontal="8dp"
                        android:paddingVertical="3dp"
                        android:text="TỰ ĐỘNG"
                        android:textColor="#475569"
                        android:textSize="10sp"
                        android:textStyle="bold" 
                        app:layout_constraintTop_toTopOf="@id/ivLocationContainer"
                        app:layout_constraintStart_toEndOf="@id/ivLocationContainer"/>

                    <TextView
                        android:id="@+id/tvLocationAddress"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_marginTop="6dp"
                        android:text="207/17B Bùi Xương Trạch, Khương Đình, Thanh Xuân, Hà Nội"
                        android:textColor="#1E293B"
                        android:textSize="14sp" 
                        android:textStyle="bold"
                        app:layout_constraintTop_toBottomOf="@id/tvLocationBadge"
                        app:layout_constraintStart_toEndOf="@id/ivLocationContainer"
                        app:layout_constraintEnd_toStartOf="@id/ivLocationArrow"/>

                    <TextView
                        android:id="@+id/tvLocationEdit"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_marginTop="4dp"
                        android:text="Chạm để thay đổi địa chỉ"
                        android:textColor="#0284c7"
                        android:textSize="13sp"
                        android:textStyle="bold" 
                        app:layout_constraintTop_toBottomOf="@id/tvLocationAddress"
                        app:layout_constraintStart_toEndOf="@id/ivLocationContainer"
                        app:layout_constraintEnd_toStartOf="@id/ivLocationArrow"/>

                    <ImageView
                        android:id="@+id/ivLocationArrow"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_arrow_right"
                        app:tint="#94A3B8" 
                        app:layout_constraintTop_toTopOf="@id/ivLocationContainer"
                        app:layout_constraintBottom_toBottomOf="@id/tvLocationEdit"
                        app:layout_constraintEnd_toEndOf="parent"/>

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/cardMap"
                        android:layout_width="0dp"
                        android:layout_height="120dp"
                        android:layout_marginTop="16dp"
                        app:cardCornerRadius="12dp"
                        app:cardElevation="0dp"
                        app:strokeWidth="1dp"
                        app:strokeColor="#E2E8F0"
                        app:layout_constraintTop_toBottomOf="@id/tvLocationEdit"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent">

                        <org.osmdroid.views.MapView
                            android:id="@+id/mapView"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent" />
                    </com.google.android.material.card.MaterialCardView>
                </androidx.constraintlayout.widget.ConstraintLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/layoutExactAddress"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                app:strokeWidth="1dp"
                app:strokeColor="#E2E8F0"
                app:cardBackgroundColor="#F8FAFC"
                app:layout_constraintTop_toBottomOf="@id/cardLocation"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="12dp">

                    <ImageView
                        android:id="@+id/ivEditAddress"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_edit"
                        app:tint="#64748B" 
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"/>

                    <EditText
                        android:id="@+id/etExactAddress"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:background="@null"
                        android:hint="Nhập số nhà, ngõ/ngách cụ thể..."
                        android:textSize="13sp" 
                        android:textColor="#1E293B"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toEndOf="@id/ivEditAddress"
                        app:layout_constraintEnd_toEndOf="parent"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardImage"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeWidth="1dp"
                app:strokeColor="#F1F5F9"
                app:layout_constraintTop_toBottomOf="@id/layoutExactAddress"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="16dp">

                    <FrameLayout
                        android:id="@+id/ivCameraContainer"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@drawable/bg_circle_light_blue"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintStart_toStartOf="parent">
                        <ImageView
                            android:id="@+id/ivCamera"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_camera"
                            app:tint="#0284c7" />
                    </FrameLayout>

                    <TextView
                        android:id="@+id/tvImageTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:text="Hình ảnh"
                        android:textColor="#1E293B"
                        android:textSize="15sp"
                        android:textStyle="bold" 
                        app:layout_constraintTop_toTopOf="@id/ivCameraContainer"
                        app:layout_constraintBottom_toTopOf="@id/tvImageDesc"
                        app:layout_constraintStart_toEndOf="@id/ivCameraContainer"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintVertical_chainStyle="packed"/>

                    <TextView
                        android:id="@+id/tvImageDesc"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:text="Hình ảnh hiện trạng giúp thợ chuẩn bị tốt hơn"
                        android:textColor="#64748B"
                        android:textSize="13sp" 
                        app:layout_constraintTop_toBottomOf="@id/tvImageTitle"
                        app:layout_constraintBottom_toBottomOf="@id/ivCameraContainer"
                        app:layout_constraintStart_toEndOf="@id/ivCameraContainer"
                        app:layout_constraintEnd_toEndOf="parent"/>

                    <HorizontalScrollView
                        android:id="@+id/scrollImages"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:scrollbars="none"
                        app:layout_constraintTop_toBottomOf="@id/tvImageDesc">

                        <LinearLayout
                            android:id="@+id/layoutImageContainer"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <!-- Nút Thêm ảnh -->
                            <androidx.constraintlayout.widget.ConstraintLayout
                                android:id="@+id/btnAddImage"
                                android:layout_width="80dp"
                                android:layout_height="80dp"
                                android:background="@drawable/bg_dashed_border">

                                <ImageView
                                    android:id="@+id/ivAddImage"
                                    android:layout_width="24dp"
                                    android:layout_height="24dp"
                                    android:src="@drawable/ic_camera"
                                    app:tint="#0284c7"
                                    app:layout_constraintTop_toTopOf="parent"
                                    app:layout_constraintBottom_toTopOf="@id/tvAddImage"
                                    app:layout_constraintStart_toStartOf="parent"
                                    app:layout_constraintEnd_toEndOf="parent"
                                    app:layout_constraintVertical_chainStyle="packed"/>

                                <TextView
                                    android:id="@+id/tvAddImage"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="4dp"
                                    android:text="Thêm"
                                    android:textColor="#0284c7"
                                    android:textSize="12sp"
                                    android:textStyle="bold"
                                    app:layout_constraintTop_toBottomOf="@id/ivAddImage"
                                    app:layout_constraintBottom_toBottomOf="parent"
                                    app:layout_constraintStart_toStartOf="parent"
                                    app:layout_constraintEnd_toEndOf="parent"/>
                            </androidx.constraintlayout.widget.ConstraintLayout>

                            <!-- Các ảnh đã chọn sẽ được thêm vào đây bằng code Java -->
                        </LinearLayout>
                    </HorizontalScrollView>
                </androidx.constraintlayout.widget.ConstraintLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardTime"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="#FFF1F2"
                app:strokeWidth="1dp"
                app:strokeColor="#FFE4E6"
                app:layout_constraintTop_toBottomOf="@id/cardImage"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="16dp">

                    <FrameLayout
                        android:id="@+id/ivTimeContainer"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@drawable/bg_circle_white"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent">
                        <ImageView
                            android:id="@+id/ivTime"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_flash"
                            app:tint="#EF4444" />
                    </FrameLayout>

                    <TextView
                        android:id="@+id/tvTimeTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:text="THỜI GIAN ĐẶT LỊCH"
                        android:textColor="#E11D48"
                        android:textSize="11sp"
                        android:textStyle="bold" 
                        app:layout_constraintTop_toTopOf="@id/ivTimeContainer"
                        app:layout_constraintBottom_toTopOf="@id/tvTimeValue"
                        app:layout_constraintStart_toEndOf="@id/ivTimeContainer"
                        app:layout_constraintEnd_toStartOf="@id/ivTimeArrow"
                        app:layout_constraintVertical_chainStyle="packed"/>

                    <TextView
                        android:id="@+id/tvTimeValue"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:text="Ngay bây giờ"
                        android:textColor="#1E293B"
                        android:textSize="16sp"
                        android:textStyle="bold" 
                        app:layout_constraintTop_toBottomOf="@id/tvTimeTitle"
                        app:layout_constraintBottom_toBottomOf="@id/ivTimeContainer"
                        app:layout_constraintStart_toEndOf="@id/ivTimeContainer"
                        app:layout_constraintEnd_toStartOf="@id/ivTimeArrow"/>

                    <ImageView
                        android:id="@+id/ivTimeArrow"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_arrow_right"
                        app:tint="#FDA4AF" 
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardNote"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeWidth="1dp"
                app:strokeColor="#F1F5F9"
                app:layout_constraintTop_toBottomOf="@id/cardTime"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="16dp">

                    <FrameLayout
                        android:id="@+id/ivNoteContainer"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@drawable/bg_circle_light_blue"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent">
                        <ImageView
                            android:id="@+id/ivNote"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_note"
                            app:tint="#0284c7" />
                    </FrameLayout>

                    <TextView
                        android:id="@+id/tvNoteTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:text="Ghi chú"
                        android:textColor="#1E293B"
                        android:textSize="15sp"
                        android:textStyle="bold" 
                        app:layout_constraintTop_toTopOf="@id/ivNoteContainer"
                        app:layout_constraintBottom_toTopOf="@id/tvNoteDesc"
                        app:layout_constraintStart_toEndOf="@id/ivNoteContainer"
                        app:layout_constraintEnd_toStartOf="@id/ivNoteArrow"
                        app:layout_constraintVertical_chainStyle="packed"/>

                    <TextView
                        android:id="@+id/tvNoteDesc"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:text="Thêm yêu cầu đặc biệt hoặc hướng dẫn thợ..."
                        android:textColor="#64748B"
                        android:textSize="13sp" 
                        app:layout_constraintTop_toBottomOf="@id/tvNoteTitle"
                        app:layout_constraintBottom_toBottomOf="@id/ivNoteContainer"
                        app:layout_constraintStart_toEndOf="@id/ivNoteContainer"
                        app:layout_constraintEnd_toStartOf="@id/ivNoteArrow"/>

                    <ImageView
                        android:id="@+id/ivNoteArrow"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_arrow_right"
                        app:tint="#94A3B8" 
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
            </com.google.android.material.card.MaterialCardView>


            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardWarranty"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="#F0FDF4"
                app:strokeWidth="1dp"
                app:strokeColor="#BBF7D0"
                app:layout_constraintTop_toBottomOf="@id/cardNote"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="16dp">

                    <ImageView
                        android:id="@+id/ivWarrantyIcon"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:background="@drawable/bg_circle_light_blue"
                        android:backgroundTint="#DCFCE7"
                        android:padding="8dp"
                        android:src="@drawable/ic_shield"
                        app:tint="#16A34A"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"/>

                    <TextView
                        android:id="@+id/tvWarrantyTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:text="Gói bảo hành FixIt Care"
                        android:textColor="#16A34A"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        app:layout_constraintTop_toTopOf="@id/ivWarrantyIcon"
                        app:layout_constraintBottom_toTopOf="@id/tvWarrantyDesc"
                        app:layout_constraintStart_toEndOf="@id/ivWarrantyIcon"
                        app:layout_constraintEnd_toStartOf="@id/switchWarranty"
                        app:layout_constraintVertical_chainStyle="packed"/>

                    <TextView
                        android:id="@+id/tvWarrantyDesc"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_marginTop="2dp"
                        android:text="Hỗ trợ bảo hành 30 ngày nếu lỗi tái phát • +5.000đ"
                        android:textColor="#22C55E"
                        android:textSize="12sp"
                        app:layout_constraintTop_toBottomOf="@id/tvWarrantyTitle"
                        app:layout_constraintBottom_toBottomOf="@id/ivWarrantyIcon"
                        app:layout_constraintStart_toEndOf="@id/ivWarrantyIcon"
                        app:layout_constraintEnd_toStartOf="@id/switchWarranty"/>

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/switchWarranty"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="false"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"/>

                </androidx.constraintlayout.widget.ConstraintLayout>
            </com.google.android.material.card.MaterialCardView>

        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>

    <include
        android:id="@+id/layoutLoading"
        layout="@layout/layout_loading"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />
</androidx.constraintlayout.widget.ConstraintLayout>