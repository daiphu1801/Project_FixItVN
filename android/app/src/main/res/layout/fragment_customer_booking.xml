<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8FAFC">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/headerLayout"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:background="#42c2ff" 
        android:paddingHorizontal="16dp"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_arrow_back"
            app:tint="@color/white" 
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>

        <TextView
            android:id="@+id/tvHeaderTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:text="Sửa máy lạnh"
            android:textColor="@color/white"
            android:textSize="18sp"
            android:textStyle="bold" 
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@id/btnBack"
            app:layout_constraintEnd_toEndOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <FrameLayout
        android:id="@+id/bottomActionLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        android:padding="16dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnFindWorker"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Tìm thợ"
            android:textSize="16sp"
            android:textStyle="bold"
            app:backgroundTint="#42C2FF"
            app:cornerRadius="12dp" />
    </FrameLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingBottom="20dp"
        app:layout_constraintTop_toBottomOf="@id/headerLayout"
        app:layout_constraintBottom_toTopOf="@id/bottomActionLayout">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardProblem"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                app:strokeWidth="1dp"
                app:strokeColor="#E2E8F0"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="16dp">

                    <ImageView
                        android:id="@+id/ivProblem"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@drawable/bg_icon_light_blue"
                        android:padding="8dp"
                        android:src="@drawable/ic_person"
                        app:tint="#0E7783" 
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"/>

                    <TextView
                        android:id="@+id/tvProblemTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:text="Vấn đề của bạn *"
                        android:textColor="#111827"
                        android:textSize="15sp"
                        android:textStyle="bold" 
                        app:layout_constraintTop_toTopOf="@id/ivProblem"
                        app:layout_constraintBottom_toTopOf="@id/tvProblemDesc"
                        app:layout_constraintStart_toEndOf="@id/ivProblem"
                        app:layout_constraintEnd_toStartOf="@id/ivProblemArrow"
                        app:layout_constraintVertical_chainStyle="packed"/>

                    <TextView
                        android:id="@+id/tvProblemDesc"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:text="Mô tả chi tiết vấn đề đang gặp"
                        android:textColor="#9CA3AF"
                        android:textSize="13sp" 
                        app:layout_constraintTop_toBottomOf="@id/tvProblemTitle"
                        app:layout_constraintBottom_toBottomOf="@id/ivProblem"
                        app:layout_constraintStart_toEndOf="@id/ivProblem"
                        app:layout_constraintEnd_toStartOf="@id/ivProblemArrow"/>

                    <ImageView
                        android:id="@+id/ivProblemArrow"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_arrow_right"
                        app:tint="#9CA3AF" 
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardLocation"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                app:strokeWidth="1dp"
                app:strokeColor="#E2E8F0"
                app:layout_constraintTop_toBottomOf="@id/cardProblem"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="16dp">

                    <ImageView
                        android:id="@+id/ivLocation"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_location"
                        app:tint="#0E7783" 
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintStart_toStartOf="parent"/>

                    <TextView
                        android:id="@+id/tvLocationBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:background="#F1F5F9"
                        android:paddingHorizontal="6dp"
                        android:paddingVertical="2dp"
                        android:text="TỰ ĐỘNG"
                        android:textColor="#64748B"
                        android:textSize="10sp"
                        android:textStyle="bold" 
                        app:layout_constraintTop_toTopOf="@id/ivLocation"
                        app:layout_constraintStart_toEndOf="@id/ivLocation"/>

                    <TextView
                        android:id="@+id/tvLocationAddress"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_marginTop="4dp"
                        android:text="207/17B Bùi Xương Trạch, Khương Đình, Thanh Xuân, Hà Nội"
                        android:textColor="#111827"
                        android:textSize="14sp" 
                        app:layout_constraintTop_toBottomOf="@id/tvLocationBadge"
                        app:layout_constraintStart_toEndOf="@id/ivLocation"
                        app:layout_constraintEnd_toStartOf="@id/ivLocationArrow"/>

                    <TextView
                        android:id="@+id/tvLocationEdit"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_marginTop="4dp"
                        android:text="Chạm để chỉnh sửa"
                        android:textColor="#42C2FF"
                        android:textSize="13sp"
                        android:textStyle="bold" 
                        app:layout_constraintTop_toBottomOf="@id/tvLocationAddress"
                        app:layout_constraintStart_toEndOf="@id/ivLocation"
                        app:layout_constraintEnd_toStartOf="@id/ivLocationArrow"/>

                    <ImageView
                        android:id="@+id/ivLocationArrow"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_arrow_right"
                        app:tint="#9CA3AF" 
                        app:layout_constraintTop_toTopOf="@id/ivLocation"
                        app:layout_constraintBottom_toBottomOf="@id/tvLocationEdit"
                        app:layout_constraintEnd_toEndOf="parent"/>

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/cardMap"
                        android:layout_width="0dp"
                        android:layout_height="120dp"
                        android:layout_marginTop="16dp"
                        app:cardCornerRadius="8dp"
                        app:cardElevation="0dp"
                        app:layout_constraintTop_toBottomOf="@id/tvLocationEdit"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent">

                        <ImageView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:scaleType="centerCrop"
                            android:src="@drawable/img_map_placeholder" /> 
                    </com.google.android.material.card.MaterialCardView>
                </androidx.constraintlayout.widget.ConstraintLayout>
            </com.google.android.material.card.MaterialCardView>

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/layoutExactAddress"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_badge_gray"
                android:padding="12dp"
                app:layout_constraintTop_toBottomOf="@id/cardLocation"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <ImageView
                    android:id="@+id/ivEditAddress"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_edit"
                    app:tint="#94A3B8" 
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"/>

                <EditText
                    android:id="@+id/etExactAddress"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:background="@null"
                    android:hint="Nhập địa chỉ chính xác nếu GPS không đúng"
                    android:textSize="13sp" 
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toEndOf="@id/ivEditAddress"
                    app:layout_constraintEnd_toEndOf="parent"/>
            </androidx.constraintlayout.widget.ConstraintLayout>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardImage"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                app:strokeWidth="1dp"
                app:strokeColor="#E2E8F0"
                app:layout_constraintTop_toBottomOf="@id/layoutExactAddress"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="16dp">

                    <ImageView
                        android:id="@+id/ivCamera"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_camera" 
                        app:tint="#0E7783" 
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintStart_toStartOf="parent"/>

                    <TextView
                        android:id="@+id/tvImageTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:text="Hình ảnh"
                        android:textColor="#111827"
                        android:textSize="15sp"
                        android:textStyle="bold" 
                        app:layout_constraintTop_toTopOf="@id/ivCamera"
                        app:layout_constraintStart_toEndOf="@id/ivCamera"
                        app:layout_constraintEnd_toEndOf="parent"/>

                    <TextView
                        android:id="@+id/tvImageDesc"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:text="Giúp thợ hiểu rõ hơn"
                        android:textColor="#9CA3AF"
                        android:textSize="13sp" 
                        app:layout_constraintTop_toBottomOf="@id/tvImageTitle"
                        app:layout_constraintStart_toEndOf="@id/ivCamera"
                        app:layout_constraintEnd_toEndOf="parent"/>

                    <HorizontalScrollView
                        android:id="@+id/scrollImages"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:scrollbars="none"
                        app:layout_constraintTop_toBottomOf="@id/tvImageDesc">

                        <LinearLayout
                            android:id="@+id/layoutImageContainer"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <!-- Nút Thêm ảnh -->
                            <androidx.constraintlayout.widget.ConstraintLayout
                                android:id="@+id/btnAddImage"
                                android:layout_width="80dp"
                                android:layout_height="80dp"
                                android:background="@drawable/bg_dashed_border">

                                <ImageView
                                    android:id="@+id/ivAddImage"
                                    android:layout_width="24dp"
                                    android:layout_height="24dp"
                                    android:src="@drawable/ic_camera"
                                    app:tint="#42C2FF"
                                    app:layout_constraintTop_toTopOf="parent"
                                    app:layout_constraintBottom_toTopOf="@id/tvAddImage"
                                    app:layout_constraintStart_toStartOf="parent"
                                    app:layout_constraintEnd_toEndOf="parent"
                                    app:layout_constraintVertical_chainStyle="packed"/>

                                <TextView
                                    android:id="@+id/tvAddImage"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="4dp"
                                    android:text="Thêm"
                                    android:textColor="#42C2FF"
                                    android:textSize="12sp"
                                    android:textStyle="bold"
                                    app:layout_constraintTop_toBottomOf="@id/ivAddImage"
                                    app:layout_constraintBottom_toBottomOf="parent"
                                    app:layout_constraintStart_toStartOf="parent"
                                    app:layout_constraintEnd_toEndOf="parent"/>
                            </androidx.constraintlayout.widget.ConstraintLayout>

                            <!-- Các ảnh đã chọn sẽ được thêm vào đây bằng code Java -->
                        </LinearLayout>
                    </HorizontalScrollView>
                </androidx.constraintlayout.widget.ConstraintLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardTime"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="#FFF1F2"
                app:strokeWidth="0dp"
                app:layout_constraintTop_toBottomOf="@id/cardImage"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="16dp">

                    <ImageView
                        android:id="@+id/ivTime"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:background="@drawable/bg_circle_white"
                        android:padding="6dp"
                        android:src="@drawable/ic_flash"
                        app:tint="#EF4444" 
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"/>

                    <TextView
                        android:id="@+id/tvTimeTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:text="THỜI GIAN"
                        android:textColor="#EF4444"
                        android:textSize="11sp"
                        android:textStyle="bold" 
                        app:layout_constraintTop_toTopOf="@id/ivTime"
                        app:layout_constraintBottom_toTopOf="@id/tvTimeValue"
                        app:layout_constraintStart_toEndOf="@id/ivTime"
                        app:layout_constraintEnd_toStartOf="@id/ivTimeArrow"
                        app:layout_constraintVertical_chainStyle="packed"/>

                    <TextView
                        android:id="@+id/tvTimeValue"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:text="Ngay bây giờ"
                        android:textColor="#111827"
                        android:textSize="16sp"
                        android:textStyle="bold" 
                        app:layout_constraintTop_toBottomOf="@id/tvTimeTitle"
                        app:layout_constraintBottom_toBottomOf="@id/ivTime"
                        app:layout_constraintStart_toEndOf="@id/ivTime"
                        app:layout_constraintEnd_toStartOf="@id/ivTimeArrow"/>

                    <ImageView
                        android:id="@+id/ivTimeArrow"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_arrow_right"
                        app:tint="#9CA3AF" 
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardNote"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                app:strokeWidth="1dp"
                app:strokeColor="#E2E8F0"
                app:layout_constraintTop_toBottomOf="@id/cardTime"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="16dp">

                    <ImageView
                        android:id="@+id/ivNote"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_note"
                        app:tint="#0E7783" 
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"/>

                    <TextView
                        android:id="@+id/tvNoteTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:text="Ghi chú"
                        android:textColor="#111827"
                        android:textSize="15sp"
                        android:textStyle="bold" 
                        app:layout_constraintTop_toTopOf="@id/ivNote"
                        app:layout_constraintBottom_toTopOf="@id/tvNoteDesc"
                        app:layout_constraintStart_toEndOf="@id/ivNote"
                        app:layout_constraintEnd_toStartOf="@id/ivNoteArrow"
                        app:layout_constraintVertical_chainStyle="packed"/>

                    <TextView
                        android:id="@+id/tvNoteDesc"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:text="Thêm yêu cầu đặc biệt..."
                        android:textColor="#9CA3AF"
                        android:textSize="13sp" 
                        app:layout_constraintTop_toBottomOf="@id/tvNoteTitle"
                        app:layout_constraintBottom_toBottomOf="@id/ivNote"
                        app:layout_constraintStart_toEndOf="@id/ivNote"
                        app:layout_constraintEnd_toStartOf="@id/ivNoteArrow"/>

                    <ImageView
                        android:id="@+id/ivNoteArrow"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_arrow_right"
                        app:tint="#9CA3AF" 
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardWarranty"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                app:strokeWidth="1dp"
                app:strokeColor="#E2E8F0"
                app:layout_constraintTop_toBottomOf="@id/cardNote"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"/>

        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>

    <include
        android:id="@+id/layoutLoading"
        layout="@layout/layout_loading"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />
</androidx.constraintlayout.widget.ConstraintLayout>