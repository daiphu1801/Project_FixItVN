<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#f5faff">

    <include
        android:id="@+id/appBarLayout"
        layout="@layout/layout_standard_appbar" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/mainConstraintContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp">

            <!-- Time Filters -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnFilterToday"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:backgroundTint="#42c2ff"
                android:text="Hôm nay"
                android:textColor="@android:color/white"
                app:cornerRadius="999dp"
                app:layout_constraintEnd_toStartOf="@+id/btnFilterWeek"
                app:layout_constraintHorizontal_chainStyle="spread"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnFilterWeek"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:backgroundTint="#e2e8f0"
                android:text="Tuần này"
                android:textColor="#4a5568"
                app:cornerRadius="999dp"
                app:layout_constraintEnd_toStartOf="@+id/btnFilterMonth"
                app:layout_constraintStart_toEndOf="@+id/btnFilterToday"
                app:layout_constraintTop_toTopOf="parent" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnFilterMonth"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:backgroundTint="#e2e8f0"
                android:text="Tháng này"
                android:textColor="#4a5568"
                app:cornerRadius="999dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/btnFilterWeek"
                app:layout_constraintTop_toTopOf="parent" />

            <!-- Section 1: Upcoming Schedule -->
            <ImageView
                android:id="@+id/ivCalendarIcon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginTop="24dp"
                android:src="@drawable/ic_lucide_calendar"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/btnFilterToday"
                app:tint="#42c2ff" />

            <TextView
                android:id="@+id/tvUpcomingTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="Lịch hẹn sắp tới"
                android:textColor="#0d1b2a"
                android:textSize="18sp"
                android:textStyle="bold"
                app:layout_constraintBottom_toBottomOf="@+id/ivCalendarIcon"
                app:layout_constraintStart_toEndOf="@+id/ivCalendarIcon"
                app:layout_constraintTop_toTopOf="@+id/ivCalendarIcon" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvUpcomingAppointments"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:clipToPadding="false"
                android:orientation="horizontal"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/ivCalendarIcon"
                tools:listitem="@layout/item_appointment_horizontal" />

            <!-- Section 2: Income Chart Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardIncomeChart"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/rvUpcomingAppointments"
                app:strokeWidth="0dp">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="16dp">

                    <ImageView
                        android:id="@+id/ivTrendIcon"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_lucide_trending_up"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:tint="#42c2ff" />

                    <TextView
                        android:id="@+id/tvChartTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="Biểu đồ Thu nhập"
                        android:textColor="#0d1b2a"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        app:layout_constraintBottom_toBottomOf="@+id/ivTrendIcon"
                        app:layout_constraintStart_toEndOf="@+id/ivTrendIcon"
                        app:layout_constraintTop_toTopOf="@+id/ivTrendIcon" />

                    <!-- Mock Chart using LinearLayout -->
                    <LinearLayout
                        android:id="@+id/layoutChart"
                        android:layout_width="0dp"
                        android:layout_height="150dp"
                        android:layout_marginTop="16dp"
                        android:gravity="bottom"
                        android:orientation="horizontal"
                        android:weightSum="7"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/ivTrendIcon">

                        <!-- Monday -->
                        <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="bottom|center_horizontal" android:orientation="vertical">
                            <View android:id="@+id/barMon" android:layout_width="24dp" android:layout_height="0dp" android:background="#d6f2ff" />
                            <TextView android:id="@+id/lblMon" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="T2" android:textColor="#4a5568" android:textSize="10sp" />
                        </LinearLayout>
                        <!-- Tuesday -->
                        <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="bottom|center_horizontal" android:orientation="vertical">
                            <View android:id="@+id/barTue" android:layout_width="24dp" android:layout_height="0dp" android:background="#d6f2ff" />
                            <TextView android:id="@+id/lblTue" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="T3" android:textColor="#4a5568" android:textSize="10sp" />
                        </LinearLayout>
                        <!-- Wednesday -->
                        <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="bottom|center_horizontal" android:orientation="vertical">
                            <View android:id="@+id/barWed" android:layout_width="24dp" android:layout_height="0dp" android:background="#d6f2ff" />
                            <TextView android:id="@+id/lblWed" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="T4" android:textColor="#4a5568" android:textSize="10sp" />
                        </LinearLayout>
                        <!-- Thursday -->
                        <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="bottom|center_horizontal" android:orientation="vertical">
                            <View android:id="@+id/barThu" android:layout_width="24dp" android:layout_height="0dp" android:background="#42c2ff" />
                            <TextView android:id="@+id/lblThu" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="T5" android:textColor="#0d1b2a" android:textSize="10sp" android:textStyle="bold" />
                        </LinearLayout>
                        <!-- Friday -->
                        <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="bottom|center_horizontal" android:orientation="vertical">
                            <View android:id="@+id/barFri" android:layout_width="24dp" android:layout_height="0dp" android:background="#d6f2ff" />
                            <TextView android:id="@+id/lblFri" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="T6" android:textColor="#4a5568" android:textSize="10sp" />
                        </LinearLayout>
                        <!-- Saturday -->
                        <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="bottom|center_horizontal" android:orientation="vertical">
                            <View android:id="@+id/barSat" android:layout_width="24dp" android:layout_height="0dp" android:background="#d6f2ff" />
                            <TextView android:id="@+id/lblSat" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="T7" android:textColor="#4a5568" android:textSize="10sp" />
                        </LinearLayout>
                        <!-- Sunday -->
                        <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="bottom|center_horizontal" android:orientation="vertical">
                            <View android:id="@+id/barSun" android:layout_width="24dp" android:layout_height="0dp" android:background="#d6f2ff" />
                            <TextView android:id="@+id/lblSun" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="CN" android:textColor="#4a5568" android:textSize="10sp" />
                        </LinearLayout>
                    </LinearLayout>

                    <View
                        android:id="@+id/viewChartDivider"
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_marginTop="16dp"
                        android:background="#e2e8f0"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/layoutChart" />

                    <!-- Total Income Metric -->
                    <TextView
                        android:id="@+id/tvTotalIncomeTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="Tổng"
                        android:textColor="#94a3b8"
                        android:textSize="12sp"
                        app:layout_constraintEnd_toStartOf="@+id/tvTotalOrdersTitle"
                        app:layout_constraintHorizontal_chainStyle="spread"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/viewChartDivider" />

                    <TextView
                        android:id="@+id/tvTotalIncome"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="2,150,000đ"
                        android:textColor="#0d1b2a"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        app:layout_constraintEnd_toEndOf="@+id/tvTotalIncomeTitle"
                        app:layout_constraintStart_toStartOf="@+id/tvTotalIncomeTitle"
                        app:layout_constraintTop_toBottomOf="@+id/tvTotalIncomeTitle" />

                    <!-- Total Orders Metric -->
                    <TextView
                        android:id="@+id/tvTotalOrdersTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="Số đơn"
                        android:textColor="#94a3b8"
                        android:textSize="12sp"
                        app:layout_constraintEnd_toStartOf="@+id/tvAvgPerOrderTitle"
                        app:layout_constraintStart_toEndOf="@+id/tvTotalIncomeTitle"
                        app:layout_constraintTop_toBottomOf="@+id/viewChartDivider" />

                    <TextView
                        android:id="@+id/tvTotalOrders"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="18"
                        android:textColor="#0d1b2a"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        app:layout_constraintEnd_toEndOf="@+id/tvTotalOrdersTitle"
                        app:layout_constraintStart_toStartOf="@+id/tvTotalOrdersTitle"
                        app:layout_constraintTop_toBottomOf="@+id/tvTotalOrdersTitle" />

                    <!-- Avg Per Order Metric -->
                    <TextView
                        android:id="@+id/tvAvgPerOrderTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="TB/đơn"
                        android:textColor="#94a3b8"
                        android:textSize="12sp"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toEndOf="@+id/tvTotalOrdersTitle"
                        app:layout_constraintTop_toBottomOf="@+id/viewChartDivider" />

                    <TextView
                        android:id="@+id/tvAvgPerOrder"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="119K"
                        android:textColor="#0d1b2a"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        app:layout_constraintEnd_toEndOf="@+id/tvAvgPerOrderTitle"
                        app:layout_constraintStart_toStartOf="@+id/tvAvgPerOrderTitle"
                        app:layout_constraintTop_toBottomOf="@+id/tvAvgPerOrderTitle" />

                </androidx.constraintlayout.widget.ConstraintLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Card Phân tích chất lượng & hiệu suất nâng cao -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardQualityPerformance"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="24dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/cardIncomeChart"
                app:strokeWidth="0dp">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="16dp">

                    <TextView
                        android:id="@+id/tvPerformanceTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Chất lượng &amp; Hiệu suất"
                        android:textColor="#0d1b2a"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <!-- 1. Tỷ lệ hoàn thành -->
                    <TextView
                        android:id="@+id/tvCompletionTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="Tỷ lệ hoàn thành đơn"
                        android:textColor="#475569"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/tvPerformanceTitle" />

                    <ProgressBar
                        android:id="@+id/pbCompletionRate"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="0dp"
                        android:layout_height="12dp"
                        android:layout_marginTop="8dp"
                        android:max="100"
                        android:progress="100"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/tvCompletionTitle" />

                    <TextView
                        android:id="@+id/tvCompletionRateText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="100% Hoàn thành (0/0 đơn)"
                        android:textColor="#64748b"
                        android:textSize="12sp"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/pbCompletionRate" />

                    <View
                        android:id="@+id/viewPerformanceDivider1"
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_marginTop="16dp"
                        android:background="#e2e8f0"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/tvCompletionRateText" />

                    <!-- 2. Phân bổ đánh giá -->
                    <TextView
                        android:id="@+id/tvRatingTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="Phân bổ đánh giá sao"
                        android:textColor="#475569"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/viewPerformanceDivider1" />

                    <!-- 5 sao -->
                    <TextView
                        android:id="@+id/lblStar5"
                        android:layout_width="45dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="5 sao"
                        android:textColor="#64748b"
                        android:textSize="12sp"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/tvRatingTitle" />

                    <TextView
                        android:id="@+id/tvStar5Count"
                        android:layout_width="30dp"
                        android:layout_height="wrap_content"
                        android:gravity="end"
                        android:text="0"
                        android:textColor="#64748b"
                        android:textSize="12sp"
                        app:layout_constraintBottom_toBottomOf="@+id/lblStar5"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="@+id/lblStar5" />

                    <ProgressBar
                        android:id="@+id/pbStar5"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="0dp"
                        android:layout_height="8dp"
                        android:layout_marginStart="12dp"
                        android:layout_marginEnd="12dp"
                        android:max="100"
                        android:progress="0"
                        app:layout_constraintBottom_toBottomOf="@+id/lblStar5"
                        app:layout_constraintEnd_toStartOf="@+id/tvStar5Count"
                        app:layout_constraintStart_toEndOf="@+id/lblStar5"
                        app:layout_constraintTop_toTopOf="@+id/lblStar5" />

                    <!-- 4 sao -->
                    <TextView
                        android:id="@+id/lblStar4"
                        android:layout_width="45dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="4 sao"
                        android:textColor="#64748b"
                        android:textSize="12sp"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/lblStar5" />

                    <TextView
                        android:id="@+id/tvStar4Count"
                        android:layout_width="30dp"
                        android:layout_height="wrap_content"
                        android:gravity="end"
                        android:text="0"
                        android:textColor="#64748b"
                        android:textSize="12sp"
                        app:layout_constraintBottom_toBottomOf="@+id/lblStar4"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="@+id/lblStar4" />

                    <ProgressBar
                        android:id="@+id/pbStar4"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="0dp"
                        android:layout_height="8dp"
                        android:layout_marginStart="12dp"
                        android:layout_marginEnd="12dp"
                        android:max="100"
                        android:progress="0"
                        app:layout_constraintBottom_toBottomOf="@+id/lblStar4"
                        app:layout_constraintEnd_toStartOf="@+id/tvStar4Count"
                        app:layout_constraintStart_toEndOf="@+id/lblStar4"
                        app:layout_constraintTop_toTopOf="@+id/lblStar4" />

                    <!-- 3 sao -->
                    <TextView
                        android:id="@+id/lblStar3"
                        android:layout_width="45dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="3 sao"
                        android:textColor="#64748b"
                        android:textSize="12sp"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/lblStar4" />

                    <TextView
                        android:id="@+id/tvStar3Count"
                        android:layout_width="30dp"
                        android:layout_height="wrap_content"
                        android:gravity="end"
                        android:text="0"
                        android:textColor="#64748b"
                        android:textSize="12sp"
                        app:layout_constraintBottom_toBottomOf="@+id/lblStar3"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="@+id/lblStar3" />

                    <ProgressBar
                        android:id="@+id/pbStar3"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="0dp"
                        android:layout_height="8dp"
                        android:layout_marginStart="12dp"
                        android:layout_marginEnd="12dp"
                        android:max="100"
                        android:progress="0"
                        app:layout_constraintBottom_toBottomOf="@+id/lblStar3"
                        app:layout_constraintEnd_toStartOf="@+id/tvStar3Count"
                        app:layout_constraintStart_toEndOf="@+id/lblStar3"
                        app:layout_constraintTop_toTopOf="@+id/lblStar3" />

                    <!-- 2 sao -->
                    <TextView
                        android:id="@+id/lblStar2"
                        android:layout_width="45dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="2 sao"
                        android:textColor="#64748b"
                        android:textSize="12sp"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/lblStar3" />

                    <TextView
                        android:id="@+id/tvStar2Count"
                        android:layout_width="30dp"
                        android:layout_height="wrap_content"
                        android:gravity="end"
                        android:text="0"
                        android:textColor="#64748b"
                        android:textSize="12sp"
                        app:layout_constraintBottom_toBottomOf="@+id/lblStar2"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="@+id/lblStar2" />

                    <ProgressBar
                        android:id="@+id/pbStar2"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="0dp"
                        android:layout_height="8dp"
                        android:layout_marginStart="12dp"
                        android:layout_marginEnd="12dp"
                        android:max="100"
                        android:progress="0"
                        app:layout_constraintBottom_toBottomOf="@+id/lblStar2"
                        app:layout_constraintEnd_toStartOf="@+id/tvStar2Count"
                        app:layout_constraintStart_toEndOf="@+id/lblStar2"
                        app:layout_constraintTop_toTopOf="@+id/lblStar2" />

                    <!-- 1 sao -->
                    <TextView
                        android:id="@+id/lblStar1"
                        android:layout_width="45dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="1 sao"
                        android:textColor="#64748b"
                        android:textSize="12sp"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/lblStar2" />

                    <TextView
                        android:id="@+id/tvStar1Count"
                        android:layout_width="30dp"
                        android:layout_height="wrap_content"
                        android:gravity="end"
                        android:text="0"
                        android:textColor="#64748b"
                        android:textSize="12sp"
                        app:layout_constraintBottom_toBottomOf="@+id/lblStar1"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="@+id/lblStar1" />

                    <ProgressBar
                        android:id="@+id/pbStar1"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="0dp"
                        android:layout_height="8dp"
                        android:layout_marginStart="12dp"
                        android:layout_marginEnd="12dp"
                        android:max="100"
                        android:progress="0"
                        app:layout_constraintBottom_toBottomOf="@+id/lblStar1"
                        app:layout_constraintEnd_toStartOf="@+id/tvStar1Count"
                        app:layout_constraintStart_toEndOf="@+id/lblStar1"
                        app:layout_constraintTop_toTopOf="@+id/lblStar1" />

                    <View
                        android:id="@+id/viewPerformanceDivider2"
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_marginTop="16dp"
                        android:background="#e2e8f0"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/lblStar1" />

                    <!-- 3. Cơ cấu dịch vụ phổ biến -->
                    <TextView
                        android:id="@+id/tvServiceBreakdownTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="Cơ cấu doanh thu theo dịch vụ"
                        android:textColor="#475569"
                        android:textSize="13sp"
                        android:textStyle="bold"
