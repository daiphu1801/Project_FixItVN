<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#f8fafc">

    <!-- TopBar -->
    <RelativeLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@android:color/white"
        android:elevation="4dp"
        android:paddingHorizontal="16dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_centerVertical="true"
            android:src="@drawable/ic_arrow_back"
            android:contentDescription="Quay lại"
            app:tint="#0f172a" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:text="Nạp tiền vào ví"
            android:textColor="#0f172a"
            android:textSize="18sp"
            android:textStyle="bold" />
    </RelativeLayout>

    <FrameLayout
        android:id="@+id/contentContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/topBar"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- STEP 1: ENTER AMOUNT -->
        <ScrollView
            android:id="@+id/scrollStep1"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="visible">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="20dp">

                <TextView
                    android:id="@+id/tvStep1Title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Nhập số tiền nạp"
                    android:textColor="#1e293b"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent" />

                <TextView
                    android:id="@+id/tvStep1Desc"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Nạp tiền vào ví giúp bạn thanh toán các khoản ghi nợ chiết khấu hoa hồng đơn hàng tiền mặt."
                    android:textColor="#64748b"
                    android:textSize="13sp"
                    app:layout_constraintTop_toBottomOf="@id/tvStep1Title"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilAmount"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    app:hintEnabled="false"
                    app:layout_constraintTop_toBottomOf="@id/tvStep1Desc"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etAmount"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Nhập số tiền cần nạp (đ)"
                        android:inputType="number"
                        android:textSize="16sp" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Amount helper buttons (Horizontal Chain) -->
                <Button
                    android:id="@+id/btn50k"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="50.000 đ"
                    android:textColor="#475569"
                    android:textSize="12sp"
                    app:layout_constraintTop_toBottomOf="@id/tilAmount"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toStartOf="@id/btn100k"
                    app:layout_constraintHorizontal_chainStyle="spread" />

                <Button
                    android:id="@+id/btn100k"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="100.000 đ"
                    android:textColor="#475569"
                    android:textSize="12sp"
                    app:layout_constraintTop_toTopOf="@id/btn50k"
                    app:layout_constraintStart_toEndOf="@id/btn50k"
                    app:layout_constraintEnd_toStartOf="@id/btn200k" />

                <Button
                    android:id="@+id/btn200k"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="200.000 đ"
                    android:textColor="#475569"
                    android:textSize="12sp"
                    app:layout_constraintTop_toTopOf="@id/btn50k"
                    app:layout_constraintStart_toEndOf="@id/btn100k"
                    app:layout_constraintEnd_toEndOf="parent" />

                <Button
                    android:id="@+id/btnGenerateQR"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="32dp"
                    android:backgroundTint="#2563eb"
                    android:text="Tạo mã thanh toán QR"
                    android:textColor="@android:color/white"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    app:cornerRadius="8dp"
                    app:layout_constraintTop_toBottomOf="@id/btn50k"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent" />
            </androidx.constraintlayout.widget.ConstraintLayout>
        </ScrollView>

        <!-- STEP 2: SHOW VietQR CODE -->
        <ScrollView
            android:id="@+id/scrollStep2"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="16dp">

                <TextView
                    android:id="@+id/tvStep2Title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Quét mã VietQR để thanh toán"
                    android:textColor="#1e293b"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent" />

                <!-- Warning/Information Banner -->
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/layoutWarningBanner"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_warning_light_orange"
                    android:padding="12dp"
                    app:layout_constraintTop_toBottomOf="@id/tvStep2Title"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent">

                    <ImageView
                        android:id="@+id/ivWarningIcon"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@android:drawable/stat_sys_warning"
                        app:tint="#f97316"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintStart_toStartOf="parent" />

                    <TextView
                        android:id="@+id/tvWarningText"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="Vui lòng chuyển đúng số tiền và nội dung chuyển khoản để hệ thống tự động cộng tiền trong 30 giây."
                        android:textColor="#ea580c"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintStart_toEndOf="@id/ivWarningIcon"
                        app:layout_constraintEnd_toEndOf="parent" />
                </androidx.constraintlayout.widget.ConstraintLayout>

                <!-- QR Container -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardQrContainer"
                    android:layout_width="220dp"
                    android:layout_height="220dp"
                    android:layout_marginTop="16dp"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="4dp"
                    app:strokeColor="#e2e8f0"
                    app:strokeWidth="1dp"
                    app:layout_constraintTop_toBottomOf="@id/layoutWarningBanner"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent">

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent">

                        <ImageView
                            android:id="@+id/ivQrCode"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:layout_margin="8dp"
                            android:src="@android:drawable/ic_menu_gallery" />

                        <ProgressBar
                            android:id="@+id/pbQrLoading"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:visibility="gone" />
                    </FrameLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Countdown Timer -->
                <TextView
                    android:id="@+id/tvCountdown"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Mã QR hết hạn trong: 09:59"
                    android:textColor="#ef4444"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    app:layout_constraintTop_toBottomOf="@id/cardQrContainer"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent" />

                <!-- Payment Details Card -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardPaymentDetails"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="1dp"
                    app:strokeColor="#e2e8f0"
                    app:strokeWidth="1dp"
                    app:layout_constraintTop_toBottomOf="@id/tvCountdown"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent">

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="16dp">

                        <!-- Ngân hàng nhận -->
                        <TextView
                            android:id="@+id/tvLabelBank"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Ngân hàng nhận"
                            android:textColor="#64748b"
                            android:textSize="13sp"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintStart_toStartOf="parent" />

                        <TextView
                            android:id="@+id/tvDepositBank"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="MB Bank (Ngân hàng Quân Đội)"
                            android:textColor="#0f172a"
                            android:textStyle="bold"
                            android:textSize="13sp"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintEnd_toEndOf="parent" />

                        <!-- Tên tài khoản -->
                        <TextView
                            android:id="@+id/tvLabelAccountName"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:text="Tên tài khoản"
                            android:textColor="#64748b"
                            android:textSize="13sp"
                            app:layout_constraintTop_toBottomOf="@id/tvLabelBank"
                            app:layout_constraintStart_toStartOf="parent" />

                        <TextView
                            android:id="@+id/tvDepositAccountName"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="CONG TY CONG NGHE FIXIT VIET NAM"
                            android:textColor="#0f172a"
                            android:textStyle="bold"
                            android:textSize="13sp"
                            app:layout_constraintTop_toTopOf="@id/tvLabelAccountName"
                            app:layout_constraintEnd_toEndOf="parent" />

                        <!-- Số tài khoản -->
                        <TextView
                            android:id="@+id/tvLabelAccount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:text="Số tài khoản"
                            android:textColor="#64748b"
                            android:textSize="13sp"
                            app:layout_constraintTop_toBottomOf="@id/tvLabelAccountName"
                            app:layout_constraintStart_toStartOf="parent" />

                        <ImageView
                            android:id="@+id/btnCopyAccount"
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:layout_marginEnd="6dp"
                            android:src="@drawable/ic_copy"
                            android:clickable="true"
                            android:focusable="true"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            app:layout_constraintTop_toTopOf="@id/tvDepositAccount"
                            app:layout_constraintBottom_toBottomOf="@id/tvDepositAccount"
                            app:layout_constraintEnd_toStartOf="@id/tvDepositAccount" />

                        <TextView
                            android:id="@+id/tvDepositAccount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="190367898888"
                            android:textColor="#2563eb"
                            android:textStyle="bold"
                            android:textSize="13sp"
                            app:layout_constraintTop_toTopOf="@id/tvLabelAccount"
                            app:layout_constraintEnd_toEndOf="parent" />

                        <!-- Số tiền -->
                        <TextView
                            android:id="@+id/tvLabelAmount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:text="Số tiền nạp"
                            android:textColor="#64748b"
                            android:textSize="13sp"
                            app:layout_constraintTop_toBottomOf="@id/tvDepositAccount"
                            app:layout_constraintStart_toStartOf="parent" />

                        <ImageView
                            android:id="@+id/btnCopyAmount"
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:layout_marginEnd="6dp"
                            android:src="@drawable/ic_copy"
                            android:clickable="true"
                            android:focusable="true"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            app:layout_constraintTop_toTopOf="@id/tvDepositAmount"
                            app:layout_constraintBottom_toBottomOf="@id/tvDepositAmount"
                            app:layout_constraintEnd_toStartOf="@id/tvDepositAmount" />

                        <TextView
                            android:id="@+id/tvDepositAmount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="75.000 đ"
                            android:textColor="#0f172a"
                            android:textStyle="bold"
                            android:textSize="13sp"
                            app:layout_constraintTop_toTopOf="@id/tvLabelAmount"
                            app:layout_constraintEnd_toEndOf="parent" />

                        <!-- Nội dung -->
                        <TextView
                            android:id="@+id/tvLabelNote"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:text="Nội dung chuyển khoản"
                            android:textColor="#64748b"
                            android:textSize="13sp"
                            app:layout_constraintTop_toBottomOf="@id/tvLabelAmount"
                            app:layout_constraintStart_toStartOf="parent" />

                        <ImageView
                            android:id="@+id/btnCopyNote"
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:layout_marginEnd="6dp"
                            android:src="@drawable/ic_copy"
                            android:clickable="true"
                            android:focusable="true"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            app:layout_constraintTop_toTopOf="@id/tvDepositNote"
                            app:layout_constraintBottom_toBottomOf="@id/tvDepositNote"
                            app:layout_constraintEnd_toStartOf="@id/tvDepositNote" />

                        <TextView
                            android:id="@+id/tvDepositNote"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="FIXIT_DEP12345"
                            android:textColor="#0f172a"
                            android:textStyle="bold"
                            android:textSize="13sp"
                            app:layout_constraintTop_toTopOf="@id/tvLabelNote"
                            app:layout_constraintEnd_toEndOf="parent" />

                        <!-- Trạng thái -->
                        <TextView
                            android:id="@+id/tvLabelStatus"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:text="Trạng thái"
                            android:textColor="#64748b"
                            android:textSize="13sp"
                            app:layout_constraintTop_toBottomOf="@id/tvLabelNote"
                            app:layout_constraintStart_toStartOf="parent" />

                        <TextView
                            android:id="@+id/tvDepositStatus"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Chờ thanh toán"
                            android:textColor="#f59e0b"
                            android:textStyle="bold"
                            android:textSize="13sp"
                            app:layout_constraintTop_toTopOf="@id/tvLabelStatus"
                            app:layout_constraintEnd_toEndOf="parent" />
                    </androidx.constraintlayout.widget.ConstraintLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Mock Simulation Section (Vàng Sleek) -->
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/layoutMockSimulation"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:background="#fef3c7"
                    android:padding="16dp"
                    app:layout_constraintTop_toBottomOf="@id/cardPaymentDetails"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent">

                    <TextView
                        android:id="@+id/tvMockTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🛠️ Giả lập Demo giao diện"
                        android:textColor="#b45309"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintStart_toStartOf="parent" />

                    <TextView
                        android:id="@+id/tvMockDesc"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Nhấn nút dưới để giả lập ngân hàng báo nhận tiền thành công từ VietQR."
                        android:textColor="#92400e"
                        android:textSize="11sp"
                        app:layout_constraintTop_toBottomOf="@id/tvMockTitle"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent" />

                    <Button
                        android:id="@+id/btnSimulateSuccess"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:layout_marginTop="12dp"
                        android:backgroundTint="#d97706"
                        android:text="Giả lập thanh công thanh toán"
                        android:textColor="@android:color/white"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        app:cornerRadius="6dp"
                        app:layout_constraintTop_toBottomOf="@id/tvMockDesc"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent" />
                </androidx.constraintlayout.widget.ConstraintLayout>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </ScrollView>

        <!-- STEP 3: CONGRATULATIONS / SUCCESS STATE -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/layoutSuccessState"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="32dp"
            android:visibility="gone">

            <ImageView
                android:id="@+id/ivSuccessStar"
                android:layout_width="100dp"
                android:layout_height="100dp"
                android:src="@android:drawable/btn_star_big_on"
                android:contentDescription="Thành công"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toTopOf="@id/tvSuccessTitle"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintVertical_chainStyle="packed" />

            <TextView
                android:id="@+id/tvSuccessTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="Nạp tiền thành công!"
                android:textColor="#22c55e"
                android:textSize="22sp"
                android:textStyle="bold"
                app:layout_constraintTop_toBottomOf="@id/ivSuccessStar"
                app:layout_constraintBottom_toTopOf="@id/tvSuccessMessage"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <TextView
                android:id="@+id/tvSuccessMessage"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:text="Số tiền nạp của bạn đã được ghi nhận. Khoản ghi nợ chiết khấu đã được giảm trừ thành công."
                android:textColor="#64748b"
                android:textSize="14sp"
                app:layout_constraintTop_toBottomOf="@id/tvSuccessTitle"
                app:layout_constraintBottom_toTopOf="@id/btnBackToWallet"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <Button
                android:id="@+id/btnBackToWallet"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="40dp"
                android:backgroundTint="#2563eb"
                android:text="Quay về màn hình ví"
                android:textColor="@android:color/white"
                android:textSize="15sp"
                android:textStyle="bold"
                app:cornerRadius="8dp"
                app:layout_constraintTop_toBottomOf="@id/tvSuccessMessage"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />
        </androidx.constraintlayout.widget.ConstraintLayout>
    </FrameLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
