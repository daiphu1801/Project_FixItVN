<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F7FA"
    android:orientation="vertical">

    <include
        android:id="@+id/appBarLayout"
        layout="@layout/layout_standard_appbar" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollOrderDetail"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp">

            <!-- Order Status & ID -->
            <TextView
                android:id="@+id/tvOrderDetailStatus"
                style="@style/FixIt.Order.Badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="#E3F2FD"
                android:text="ĐANG THỰC HIỆN"
                android:textColor="#0ea5e9"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/tvOrderId"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="#ODR-123456"
                android:textColor="#94a3b8"
                android:textSize="12sp"
                app:layout_constraintBottom_toBottomOf="@id/tvOrderDetailStatus"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@id/tvOrderDetailStatus" />

            <!-- Map Placeholder -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardMapPlaceholder"
                style="@style/FixIt.Card.Content"
                android:layout_width="0dp"
                android:layout_height="180dp"
                android:layout_marginTop="16dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tvOrderDetailStatus">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="#f1f5f9"
                        android:scaleType="centerCrop"
                        android:src="@drawable/circle_background"
                        app:tint="#e2e8f0" />

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent">

                        <ImageView
                            android:id="@+id/ivMapPin"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:src="@drawable/ic_lucide_map_pin"
                            app:layout_constraintBottom_toTopOf="@id/tvMapLabel"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintVertical_chainStyle="packed"
                            app:tint="#0ea5e9" />

                        <TextView
                            android:id="@+id/tvMapLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="Xem bản đồ"
                            android:textColor="#0ea5e9"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@id/ivMapPin" />
                    </androidx.constraintlayout.widget.ConstraintLayout>
                </FrameLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Service Title -->
            <TextView
                android:id="@+id/tvOrderDetailService"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="Sửa rò rỉ ống nước bồn rửa chén"
                android:textColor="#0d1b2a"
                android:textSize="22sp"
                android:textStyle="bold"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/cardMapPlaceholder" />

            <!-- Customer Info Card -->
            <include
                android:id="@+id/cardCustomerInfo"
                layout="@layout/layout_order_customer_card"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tvOrderDetailService" />

            <!-- Order Meta (Address, Time, Payment method) -->
            <include
                android:id="@+id/cardOrderMeta"
                layout="@layout/layout_order_meta_card"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/cardCustomerInfo" />

            <!-- Timeline Header -->
            <TextView
                android:id="@+id/tvTimelineHeader"
                style="@style/FixIt.Text.SectionHeader"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="Tiến độ công việc"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/cardOrderMeta" />

            <!-- Timeline Card -->
            <include
                android:id="@+id/cardTimeline"
                layout="@layout/layout_order_timeline_card"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tvTimelineHeader" />

            <!-- Issue Description Header -->
            <TextView
                android:id="@+id/tvIssueHeader"
                style="@style/FixIt.Text.SectionHeader"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Mô tả sự cố từ khách"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/cardTimeline" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardIssueDescription"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:cardBackgroundColor="#f8fafc"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tvIssueHeader"
                app:strokeColor="#e2e8f0"
                app:strokeWidth="1dp">

                <TextView
                    android:id="@+id/tvOrderDetailIssueDescription"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:lineSpacingExtra="4dp"
                    android:padding="16dp"
                    android:text="Vòi nước bồn rửa chén bị rò rỉ mạnh ở phần cổ xoay."
                    android:textColor="#475569"
                    android:textSize="14sp" />
            </com.google.android.material.card.MaterialCardView>

            <!-- Proof of Work Photos -->
            <include
                android:id="@+id/sectionProofOfWork"
                layout="@layout/layout_proof_of_work_section"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/cardIssueDescription" />

            <!-- Pricing Summary -->
            <include
                android:id="@+id/cardPricingSummary"
                layout="@layout/layout_pricing_summary_card"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/sectionProofOfWork" />

            <!-- Worker Payment (QR / Cash) -->
            <include
                android:id="@+id/sectionPayment"
                layout="@layout/layout_worker_payment_section"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:visibility="gone"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/cardPricingSummary" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Bottom Actions -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/white"
        android:elevation="16dp"
        android:padding="16dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCancelOrderDetail"
            style="@style/FixIt.Button.Action"
            android:layout_width="wrap_content"
            android:layout_height="56dp"
            android:layout_marginEnd="12dp"
            android:paddingHorizontal="24dp"
            android:text="Hủy đơn"
            android:textColor="#ef4444"
            app:backgroundTint="#fee2e2"
            app:rippleColor="#fca5a5"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCompleteOrderDetail"
            style="@style/FixIt.Button.Action"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_marginStart="12dp"
            android:text="Cập nhật tiến độ tiếp theo"
            android:textColor="@android:color/white"
            app:backgroundTint="#0ea5e9"
            app:rippleColor="#80ffffff"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/btnCancelOrderDetail"
            app:layout_constraintTop_toTopOf="parent" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnBottomConfirmCash"
            style="@style/FixIt.Button.Action"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_marginEnd="8dp"
            android:text="Tiền mặt"
            android:textColor="#10b981"
            android:visibility="gone"
            app:backgroundTint="#d1fae5"
            app:rippleColor="#a7f3d0"
            app:icon="@drawable/ic_lucide_wallet"
            app:iconTint="#10b981"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@id/btnBottomShowQr"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnBottomShowQr"
            style="@style/FixIt.Button.Action"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:text="Hiện mã QR"
            android:textColor="@android:color/white"
            android:visibility="gone"
            app:backgroundTint="#0ea5e9"
            app:rippleColor="#80ffffff"
            app:icon="@drawable/ic_lucide_receipt"
            app:iconTint="@android:color/white"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/btnBottomConfirmCash"
            app:layout_constraintTop_toTopOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</LinearLayout>
