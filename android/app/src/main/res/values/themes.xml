<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!--
        Theme chính của ứng dụng FixIt VN.
        Kế thừa từ Theme.MaterialComponents.DayNight.NoActionBar để:
        - Tương thích đầy đủ với Material Components (BottomNavigationView, MaterialCardView, SwitchMaterial...)
        - Không có ActionBar mặc định (ta tự vẽ header trong layout)
        - Hỗ trợ Dark/Light mode
    -->
    <style name="Theme.FixItVN" parent="Theme.MaterialComponents.DayNight.NoActionBar">

        <!-- Primary Color (Sky Blue) từ Stitch Design System -->
        <item name="colorPrimary">#42c2ff</item>
        <item name="colorPrimaryDark">#00658b</item>
        <item name="colorPrimaryVariant">#00658b</item>
        <item name="colorOnPrimary">#ffffff</item>

        <!-- Secondary -->
        <item name="colorSecondary">#42c2ff</item>
        <item name="colorSecondaryVariant">#1a9fe0</item>
        <item name="colorOnSecondary">#ffffff</item>

        <!-- Background -->
        <item name="android:colorBackground">#f0faff</item>
        <item name="android:windowBackground">#f0faff</item>
        <item name="colorSurface">#ffffff</item>
        <item name="colorOnSurface">#0d1b2a</item>

        <!-- Status bar màu trắng, icon tối -->
        <item name="android:statusBarColor">#ffffff</item>
        <item name="android:windowLightStatusBar">true</item>

        <!-- Navigation bar màu trắng -->
        <item name="android:navigationBarColor">#ffffff</item>

        <!-- Tùy chỉnh Bottom Navigation cho nhỏ gọn -->
        <item name="bottomNavigationStyle">@style/Widget.FixIt.BottomNavigationView</item>

    </style>

    <style name="Widget.FixIt.BottomNavigationView" parent="Widget.MaterialComponents.BottomNavigationView">
        <item name="itemTextAppearanceActive">@style/TextAppearance.FixIt.BottomNav</item>
        <item name="itemTextAppearanceInactive">@style/TextAppearance.FixIt.BottomNav</item>
    </style>

    <style name="TextAppearance.FixIt.BottomNav" parent="TextAppearance.MaterialComponents.Caption">
        <item name="android:textSize">10sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

</resources>
