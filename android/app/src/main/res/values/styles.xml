<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base Styles for inheritance -->
    <style name="FixIt" />
    <style name="FixIt.Text" />
    <style name="FixIt.Card" />
    <style name="FixIt.Button" />
    <style name="FixIt.Order" />

    <!-- Style cho các thẻ Card nội dung trắng -->
    <style name="FixIt.Card.Content" parent="Widget.MaterialComponents.CardView">
        <item name="cardBackgroundColor">@android:color/white</item>
        <item name="cardCornerRadius">16dp</item>
        <item name="cardElevation">2dp</item>
        <item name="strokeWidth">0dp</item>
        <item name="android:layout_marginBottom">16dp</item>
    </style>

    <!-- Style cho tiêu đề các mục (Section Header) -->
    <style name="FixIt.Text.SectionHeader">
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">#0d1b2a</item>
        <item name="android:textStyle">bold</item>
        <item name="android:layout_marginBottom">12dp</item>
        <item name="android:layout_marginTop">8dp</item>
    </style>

    <!-- Style cho hàng thông tin (Icon + Text) -->
    <style name="FixIt.Text.InfoRow">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">#0d1b2a</item>
        <item name="android:layout_marginStart">12dp</item>
    </style>

    <!-- Style cho nhãn trạng thái (Status Badge) -->
    <style name="FixIt.Order.Badge">
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:paddingHorizontal">12dp</item>
        <item name="android:paddingVertical">6dp</item>
    </style>

    <!-- Style cơ bản cho nút hành động -->
    <style name="FixIt.Button.Action" parent="Widget.MaterialComponents.Button">
        <item name="android:layout_height">56dp</item>
        <item name="cornerRadius">12dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>

    <style name="FixIt.Button.Action.Outlined" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:layout_height">56dp</item>
        <item name="cornerRadius">12dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>

    <style name="FixIt.Button.Action.Primary" parent="FixIt.Button.Action">
        <item name="backgroundTint">?attr/colorPrimary</item>
        <item name="android:textColor">@android:color/white</item>
    </style>

</resources>
