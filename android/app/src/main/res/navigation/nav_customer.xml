<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_customer"
    app:startDestination="@id/nav_customer_home">

    <!-- TRANG CHỦ -->
    <fragment
        android:id="@+id/nav_customer_home"
        android:name="com.fixit.feature.customer.home.presentation.CustomerHomeFragment"
        android:label="Trang chủ"
        tools:layout="@layout/fragment_customer_home" />

    <!-- TRANG TÌM KIẾM DỊCH VỤ -->
    <fragment
        android:id="@+id/nav_customer_search"
        android:name="com.fixit.feature.customer.search.presentation.CustomerSearchFragment"
        android:label="Tìm kiếm"
        tools:layout="@layout/fragment_customer_search" />

    <!-- TRANG ĐƠN HÀNG THÔNG MINH (CẬP NHẬT MỚI) -->
    <!-- Đây là trang trung gian sẽ tự quyết định hiển thị Radar, Chi tiết đơn hoặc Trạng thái trống -->
    <fragment
        android:id="@+id/nav_customer_order"
        android:name="com.fixit.feature.customer.order.presentation.CustomerOrderContainerFragment"
        android:label="Đơn hàng"
        tools:layout="@layout/fragment_customer_order_container" />

    <!-- TRANG LỊCH SỬ -->
    <fragment
        android:id="@+id/nav_customer_history"
        android:name="com.fixit.feature.customer.history.presentation.OrderHistoryFragment"
        android:label="Lịch sử"
        tools:layout="@layout/fragment_customer_order_history" />

    <!-- TRANG THỢ QUEN -->
    <fragment
        android:id="@+id/nav_customer_contacts"
        android:name="com.fixit.feature.customer.favorite.presentation.FavoriteWorkersFragment"
        android:label="Thợ quen"
        tools:layout="@layout/fragment_favorite_workers" />

    <!-- TRANG CÁ NHÂN -->
    <fragment
        android:id="@+id/nav_customer_profile"
        android:name="com.fixit.feature.customer.profile.presentation.ProfileCustomerFragment"
        android:label="Cá nhân"
        tools:layout="@layout/fragment_profile_customer" />

    <fragment
        android:id="@+id/nav_customer_account_info"
        android:name="com.fixit.feature.customer.profile.presentation.CustomerAccountInfoFragment"
        android:label="Thông tin tài khoản"
        tools:layout="@layout/fragment_customer_account_info" />

    <!-- TRANG ĐẶT THỢ (BOOKING) -->
    <fragment
        android:id="@+id/nav_customer_booking"
        android:name="com.fixit.feature.customer.booking.presentation.CustomerBookingFragment"
        android:label="Đặt thợ"
        tools:layout="@layout/fragment_customer_booking" />

    <fragment
        android:id="@+id/nav_customer_note_input"
        android:name="com.fixit.feature.customer.booking.presentation.NoteInputFragment"
        android:label="Ghi chú"
        tools:layout="@layout/fragment_note_input" />

    <fragment
        android:id="@+id/nav_customer_location_picker"
        android:name="com.fixit.feature.customer.booking.presentation.CustomerLocationPickerFragment"
        android:label="Chọn địa điểm"
        tools:layout="@layout/fragment_customer_location_picker" />

    <!-- CÁC ĐIỂM ĐẾN PHỤ TRỢ (DÙNG ĐỂ CHUYỂN TRANG RIÊNG BIỆT KHI CẦN) -->
    <fragment
        android:id="@+id/nav_customer_finding_worker"
        android:name="com.fixit.feature.customer.booking.presentation.CustomerFindingWorkerFragment"
        android:label="Đang tìm thợ"
        tools:layout="@layout/fragment_customer_finding_worker" />

    <fragment
        android:id="@+id/nav_customer_order_detail_finished"
        android:name="com.fixit.feature.customer.history.presentation.OrderDetailFinishedFragment"
        android:label="Chi tiết đơn hàng"
        tools:layout="@layout/fragment_order_detail_finished" />

    <fragment
        android:id="@+id/nav_customer_worker_public_profile"
        android:name="com.fixit.feature.customer.workerprofile.presentation.WorkerPublicProfileFragment"
        android:label="Hồ sơ thợ"
        tools:layout="@layout/fragment_worker_public_profile">
        <argument
            android:name="workerId"
            app:argType="string"
            android:defaultValue="" />
        <argument
            android:name="workerName"
            app:argType="string"
            android:defaultValue="Thợ" />
    </fragment>

    <fragment
        android:id="@+id/nav_customer_order_detail"
        android:name="com.fixit.feature.customer.order.presentation.CustomerOrderDetailFragment"
        android:label="Chi tiết đơn hàng"
        tools:layout="@layout/fragment_customer_order_detail" />

    <fragment
        android:id="@+id/nav_customer_cancel_order"
        android:name="com.fixit.feature.customer.order.presentation.CustomerCancelOrderFragment"
        android:label="Hủy đơn hàng"
        tools:layout="@layout/fragment_customer_cancel_order" />

    <!-- ===== CHAT ===== -->
    <!-- Màn hình danh sách hội thoại -->
    <fragment
        android:id="@+id/nav_customer_list_msg"
        android:name="com.fixit.feature.customer.chat.presentation.CustomerListMsgFragment"
        android:label="Tin nhắn"
        tools:layout="@layout/fragment_list_msg">
        <argument
            android:name="isTopLevel"
            app:argType="boolean"
            android:defaultValue="false" />
        <action
            android:id="@+id/action_list_msg_to_chat"
            app:destination="@id/nav_customer_chat"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right" />
    </fragment>

    <!-- Màn hình chat chi tiết 1-1 -->
    <fragment
        android:id="@+id/nav_customer_chat"
        android:name="com.fixit.feature.customer.chat.presentation.ChatCustomerFragment"
        android:label="Chat"
        tools:layout="@layout/fragment_chat_customer">
        <argument
            android:name="workerName"
            app:argType="string"
            android:defaultValue="Thợ" />
        <argument
            android:name="workerId"
            app:argType="string"
            android:defaultValue="" />
    </fragment>

    <fragment
        android:id="@+id/nav_worker_public_profile"
        android:name="com.fixit.feature.customer.workerprofile.presentation.WorkerPublicProfileFragment"
        android:label="Hồ sơ thợ"
        tools:layout="@layout/fragment_worker_public_profile">
        <argument
            android:name="workerId"
            app:argType="string"
            android:defaultValue="" />
    </fragment>

    <fragment
        android:id="@+id/confirmPaymentFragment"
        android:name="com.fixit.feature.payment.presentation.ConfirmPaymentFragment"
        android:label="Xác nhận thanh toán"
        tools:layout="@layout/fragment_confirm_payment">
        <argument
            android:name="isWorker"
            app:argType="boolean"
            android:defaultValue="false" />
    </fragment>

    <!-- KHIẾU NẠI / BẢO HÀNH -->
    <fragment
        android:id="@+id/nav_customer_complaint_create"
        android:name="com.fixit.feature.customer.complaint.presentation.CustomerComplaintCreateFragment"
        android:label="Tạo khiếu nại"
        tools:layout="@layout/fragment_customer_complaint_create">
        <argument
            android:name="bookingId"
            app:argType="string" />
    </fragment>

    <fragment
        android:id="@+id/nav_customer_complaint_detail"
        android:name="com.fixit.feature.customer.complaint.presentation.CustomerComplaintDetailFragment"
        android:label="Chi tiết khiếu nại"
        tools:layout="@layout/fragment_customer_complaint_detail">
        <argument
            android:name="bookingId"
            app:argType="string" />
    </fragment>

    <!-- ĐỊA CHỈ & ĐỔI MẬT KHẨU CUSTOMER -->
    <fragment
        android:id="@+id/nav_customer_address"
        android:name="com.fixit.feature.customer.profile.presentation.AddressFragment"
        android:label="Địa chỉ của tôi"
        tools:layout="@layout/fragment_customer_address_list" />

    <fragment
        android:id="@+id/nav_customer_address_add_edit"
        android:name="com.fixit.feature.customer.profile.presentation.CustomerAddressAddEditFragment"
        android:label="Cập nhật địa chỉ"
        tools:layout="@layout/fragment_customer_address_add_edit">
        <argument
            android:name="addressId"
            app:argType="string"
            android:defaultValue="" />
        <argument
            android:name="label"
            app:argType="string"
            android:defaultValue="" />
        <argument
            android:name="address"
            app:argType="string"
            android:defaultValue="" />
        <argument
            android:name="defaultAddress"
            app:argType="boolean"
            android:defaultValue="false" />
    </fragment>

    <fragment
        android:id="@+id/nav_customer_change_password"
        android:name="com.fixit.feature.worker.profile.presentation.ChangePasswordFragment"
        android:label="Đổi mật khẩu"
        tools:layout="@layout/fragment_change_password" />

</navigation>
